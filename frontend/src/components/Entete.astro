---
/**
 * En-tête du site : marque, menu vertical à droite (une pilule par section),
 * réglages (niveau de lecture, langue, thème) et menu mobile.
 */
import Icone from './Icone.astro';
import ChoixThemes from './ChoixThemes.astro';
import { ui } from '@/i18n/ui';
import { routes, sections, type Langue } from '@/i18n';
import { profil } from '@/data/profil';

interface Props {
  langue: Langue;
  /** Adresse de la même page dans l'autre langue. */
  autreLangue: { langue: Langue; href: string };
  /** Sur l'accueil, les liens pointent vers les sections de la page. */
  surAccueil?: boolean;
}
const { langue: l, autreLangue, surAccueil = false } = Astro.props;
const lienSection = (id: string) => (surAccueil ? `#${id}` : routes.section(l, id));
---

<header class="entete" data-entete>
  <div class="entete__barre conteneur">
    <a class="marque" href={routes.accueil(l)} aria-label={`${profil.nomComplet} — ${ui.commun.retourAccueil[l]}`}>
      <svg class="marque__signe" viewBox="0 0 32 32" width="36" height="36" aria-hidden="true">
        <rect width="32" height="32" rx="9" fill="var(--accent)"></rect>
        <path
          d="M6.5 22.5v-13l5.25 7.6L17 9.5v13M21 9.5h2.3a3.3 3.3 0 0 1 0 6.6H21m0 0h2.9a3.2 3.2 0 0 1 0 6.4H21v-13"
          fill="none"
          stroke="var(--sur-accent)"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
      <span class="marque__nom">{profil.nomComplet}</span>
    </a>

    <div class="outils">
      <div class="lecture" role="group" aria-label={`${ui.reglages.lecture[l]} — ${ui.reglages.lectureAide[l]}`}>
        <button type="button" data-choix-lecture="simple" aria-pressed="true">{ui.reglages.simple[l]}</button>
        <button type="button" data-choix-lecture="technique" aria-pressed="false">{ui.reglages.technique[l]}</button>
      </div>

      <a
        class="outil outil--langue"
        href={autreLangue.href}
        hreflang={autreLangue.langue}
        lang={autreLangue.langue}
        aria-label={`${autreLangue.langue.toUpperCase()} — ${ui.reglages.changerLangue[l]}`}
        title={ui.reglages.changerLangue[l]}
        data-lien-langue
      >
        {autreLangue.langue.toUpperCase()}
      </a>

      <button
        type="button"
        class="outil"
        popovertarget="themes"
        aria-label={ui.reglages.choisirTheme[l]}
        title={ui.reglages.choisirTheme[l]}
      >
        <!-- L'icône suit le thème : lune (sombre), soleil (clair), ciel (bleu), feuille (vert) -->
        <span class="theme-icone" data-pour="sombre"><Icone nom="lune" taille={20} /></span>
        <span class="theme-icone" data-pour="clair"><Icone nom="soleil" taille={20} /></span>
        <span class="theme-icone" data-pour="bleu"><Icone nom="nuage-soleil" taille={20} /></span>
        <span class="theme-icone" data-pour="vert"><Icone nom="feuille" taille={20} /></span>
      </button>

      <button
        type="button"
        class="outil outil--palette"
        data-ouvrir-palette
        aria-label={ui.reglages.commandes[l]}
        title={`${ui.reglages.commandes[l]} (Ctrl K)`}
        aria-haspopup="dialog"
      >
        <Icone nom="recherche" taille={20} />
      </button>

      <button type="button" class="outil outil--menu" data-ouvrir-menu aria-label={ui.commun.menu[l]} aria-haspopup="dialog">
        <Icone nom="menu" taille={22} />
      </button>
    </div>
  </div>
  <div class="entete__progression" aria-hidden="true"></div>
</header>

<!-- Menu vertical à droite (grands écrans) : les « pilules » de Yeabsira Tarekegn (composant PillNav
     de React Bits), traduites sans bibliothèque. La pilule de la section en cours est remplie. -->
<nav class="pilules" aria-label={ui.nav.titre[l]} data-pilules>
  <!-- Poignée : on attrape le menu pour le déplacer (double-clic : retour à sa place) -->
  <span class="pilules__poignee" title={ui.nav.deplacer[l]} aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></span>
  <ul role="list">
    {
      sections.map((id) => (
        <li>
          <a class="pilule" href={lienSection(id)} data-arret={id} draggable="false">
            <span class="pilule__cercle" aria-hidden="true" />
            <span class="pilule__pile">
              <span class="pilule__texte">{ui.nav[id][l]}</span>
              <span class="pilule__texte-survol" aria-hidden="true">
                {ui.nav[id][l]}
              </span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<script>
  // Taille du cercle de chaque pilule (même calcul que PillNav) : il part du bas et remplit la pilule.
  const placer = () => {
    document.querySelectorAll<HTMLElement>('.pilule').forEach((p) => {
      const c = p.querySelector<HTMLElement>('.pilule__cercle');
      if (!c) return;
      const { width: w, height: h } = p.getBoundingClientRect();
      if (!w || !h) return;
      const R = (w * w) / 4 / (2 * h) + h / 2;
      const D = Math.ceil(2 * R) + 2;
      const delta = Math.ceil(R - Math.sqrt(Math.max(0, R * R - (w * w) / 4))) + 1;
      c.style.width = `${D}px`;
      c.style.height = `${D}px`;
      c.style.bottom = `-${delta}px`;
      c.style.transformOrigin = `50% ${D - delta}px`;
      p.style.setProperty('--h', `${h}px`);
    });
  };
  placer();
  addEventListener('resize', placer);
  document.fonts?.ready.then(placer);

  // Menu déplaçable à la souris (ou au doigt), comme une fenêtre. Position retenue entre les visites.
  const menu = document.querySelector<HTMLElement>('[data-pilules]');
  if (menu) {
    const CLE = 'menu-position';
    const borner = (x: number, y: number) => {
      const r = menu.getBoundingClientRect();
      return { x: Math.min(Math.max(8, x), innerWidth - r.width - 8), y: Math.min(Math.max(8, y), innerHeight - r.height - 8) };
    };
    const poser = (x: number, y: number) => {
      const p = borner(x, y);
      menu.style.left = `${p.x}px`;
      menu.style.top = `${p.y}px`;
      menu.style.right = 'auto';
      menu.style.transform = 'none';
      return p;
    };
    try {
      const memo = JSON.parse(localStorage.getItem(CLE) ?? 'null');
      if (memo) poser(memo.x * innerWidth, memo.y * innerHeight);
    } catch {}

    let depart: { x: number; y: number; gauche: number; haut: number } | null = null;
    let deplace = false;
    menu.addEventListener('pointerdown', (e) => {
      if (e.button > 0) return;
      e.preventDefault(); // pas de glisser-déposer natif des liens, pas de sélection de texte
      const r = menu.getBoundingClientRect();
      depart = { x: e.clientX, y: e.clientY, gauche: r.left, haut: r.top };
      deplace = false;
    });
    addEventListener('pointermove', (e) => {
      if (!depart) return;
      const dx = e.clientX - depart.x;
      const dy = e.clientY - depart.y;
      if (!deplace && dx * dx + dy * dy < 25) return; // un simple clic reste un clic
      if (!deplace) {
        deplace = true;
        menu.dataset.deplacement = '';
      }
      poser(depart.gauche + dx, depart.haut + dy);
    });
    const lacher = () => {
      if (!depart) return;
      depart = null;
      delete menu.dataset.deplacement;
      if (!deplace) return;
      const r = menu.getBoundingClientRect();
      try {
        localStorage.setItem(CLE, JSON.stringify({ x: r.left / innerWidth, y: r.top / innerHeight }));
      } catch {}
    };
    addEventListener('pointerup', lacher);
    addEventListener('pointercancel', lacher);
    // Après un déplacement, le lâcher ne doit pas ouvrir un lien.
    menu.addEventListener(
      'click',
      (e) => {
        if (deplace) {
          e.preventDefault();
          e.stopPropagation();
          deplace = false;
        }
      },
      true,
    );
    menu.querySelector('.pilules__poignee')?.addEventListener('dblclick', () => {
      menu.removeAttribute('style');
      try {
        localStorage.removeItem(CLE);
      } catch {}
    });
    addEventListener('resize', () => {
      if (menu.style.left) {
        const r = menu.getBoundingClientRect();
        poser(r.left, r.top);
      }
    });
  }
</script>

<!-- Choix du thème (fenêtre native « popover ») -->
<div id="themes" class="themes-volet" popover>
  <p class="etiquette">{ui.reglages.choisirTheme[l]}</p>
  <ChoixThemes langue={l} />
</div>

<!-- Menu mobile (fenêtre modale native) -->
<dialog class="menu" data-menu aria-label={ui.commun.menu[l]}>
  <div class="menu__tete">
    <span class="etiquette">{ui.commun.menu[l]}</span>
    <button type="button" class="outil" data-fermer-menu aria-label={ui.commun.fermer[l]}>
      <Icone nom="fermer" taille={22} />
    </button>
  </div>
  <nav aria-label={ui.nav.titre[l]}>
    <ol role="list" class="menu__liens">
      {
        sections.map((id, i) => (
          <li>
            <a href={lienSection(id)} data-fermer-menu>
              <span class="pastille">{String(i + 1).padStart(2, '0')}</span>
              {ui.nav[id][l]}
            </a>
          </li>
        ))
      }
      <li>
        <a href={routes.cv(l)} data-fermer-menu>
          <span class="pastille">CV</span>
          {ui.contact.cvPage[l]}
        </a>
      </li>
    </ol>
  </nav>
  <div class="menu__reglages">
    <div>
      <p class="etiquette">{ui.reglages.lecture[l]}</p>
      <div class="lecture lecture--large" role="group" aria-label={ui.reglages.lecture[l]}>
        <button type="button" data-choix-lecture="simple" aria-pressed="true">{ui.reglages.simple[l]}</button>
        <button type="button" data-choix-lecture="technique" aria-pressed="false">{ui.reglages.technique[l]}</button>
      </div>
      <p class="menu__aide">{ui.reglages.lectureAide[l]}</p>
    </div>
    <div>
      <p class="etiquette">{ui.reglages.theme[l]}</p>
      <ChoixThemes langue={l} />
    </div>
  </div>
</dialog>

<style>
  .theme-icone {
    display: none;
  }
  :global(html:not([data-theme])) .theme-icone[data-pour='bleu'],
  :global([data-theme='sombre']) .theme-icone[data-pour='sombre'],
  :global([data-theme='clair']) .theme-icone[data-pour='clair'],
  :global([data-theme='bleu']) .theme-icone[data-pour='bleu'],
  :global([data-theme='vert']) .theme-icone[data-pour='vert'] {
    display: grid;
  }
  .entete {
    position: sticky;
    inset-block-start: 0;
    z-index: 50;
    view-transition-name: entete;
    background: color-mix(in oklch, var(--fond) 88%, transparent);
    backdrop-filter: blur(14px) saturate(1.4);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
    border-block-end: 1px solid transparent;
    transition: border-color 0.3s;
  }
  .entete[data-defile] {
    border-block-end-color: var(--trait);
  }
  .entete__barre {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    block-size: var(--entete-h);
  }

  /* Barre de progression de lecture, pilotée par le défilement (CSS seul) */
  .entete__progression {
    position: absolute;
    inset: auto 0 -1px 0;
    block-size: 2px;
    background: var(--accent-encre);
    transform-origin: 0 50%;
    transform: scaleX(0);
  }
  @supports (animation-timeline: scroll()) {
    .entete__progression {
      animation: progression linear both;
      animation-timeline: scroll(root block);
    }
    @keyframes progression {
      to {
        transform: scaleX(1);
      }
    }
  }

  .marque {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    font-family: var(--f-etiquette);
    font-weight: 650;
    font-size: 0.9375rem;
    letter-spacing: -0.01em;
    white-space: nowrap;
    border-radius: var(--rayon-s);
  }
  .marque__signe {
    flex: none;
    transition: transform 0.6s var(--ressort);
  }
  .marque:hover .marque__signe {
    transform: rotate(-8deg) scale(1.06);
  }
  .marque__nom {
    display: none;
  }

  /* ---- Menu vertical à droite (pilules) ---- */
  .pilules {
    display: none;
  }
  @media (min-width: 72em) {
    .pilules {
      position: fixed;
      inset-block-start: 50%;
      inset-inline-end: 1rem;
      z-index: 40;
      display: block;
      padding: 4px;
      border: 1px solid var(--trait);
      border-radius: 28px;
      background: color-mix(in oklch, var(--surface) 72%, transparent);
      box-shadow: 0 12px 30px rgb(0 0 0 / 0.22);
      backdrop-filter: blur(16px);
      transform: translateY(-50%);
    }
  }
  .pilules {
    touch-action: none;
    user-select: none;
  }
  .pilules[data-deplacement] {
    cursor: grabbing;
    box-shadow: 0 18px 40px rgb(0 0 0 / 0.32);
  }
  .pilules__poignee {
    display: grid;
    grid-template-columns: repeat(3, 4px);
    gap: 3px;
    justify-content: center;
    padding: 6px 0 8px;
    cursor: grab;
  }
  .pilules__poignee i {
    inline-size: 4px;
    block-size: 4px;
    border-radius: 50%;
    background: var(--encre-2);
    opacity: 0.6;
  }
  .pilules ul {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 3px;
    margin: 0;
    padding: 0;
  }
  .pilule {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    block-size: 44px;
    padding-inline: 16px;
    overflow: hidden;
    border: 1px solid var(--trait);
    border-radius: 999px;
    background: color-mix(in oklch, var(--encre) 5%, transparent);
    color: var(--encre-2);
    font-family: var(--f-etiquette);
    font-size: 15px;
    font-weight: 550;
    letter-spacing: 0.02em;
    line-height: 1;
    white-space: nowrap;
    text-decoration: none;
    transition:
      border-color 0.2s,
      background-color 0.2s;
  }
  .pilule:hover {
    border-color: var(--trait-fort);
  }
  .pilule__cercle {
    position: absolute;
    inset-inline-start: 50%;
    z-index: 1;
    display: block;
    border-radius: 50%;
    background: color-mix(in oklch, var(--encre) 16%, var(--surface));
    transform: translateX(-50%) scale(0);
    transition: transform 0.6s var(--sortie);
    pointer-events: none;
    will-change: transform;
  }
  .pilule__pile {
    position: relative;
    z-index: 2;
    display: inline-block;
    line-height: 1;
  }
  .pilule__texte,
  .pilule__texte-survol {
    display: inline-block;
    transition:
      transform 0.6s var(--sortie),
      opacity 0.6s var(--sortie);
  }
  .pilule__texte-survol {
    position: absolute;
    inset: 0 auto auto 0;
    color: var(--encre);
    opacity: 0;
    transform: translateY(calc(var(--h, 44px) + 12px));
  }
  .pilule:hover .pilule__cercle,
  .pilule:focus-visible .pilule__cercle {
    transform: translateX(-50%) scale(1.2);
  }
  .pilule:hover .pilule__texte,
  .pilule:focus-visible .pilule__texte {
    transform: translateY(calc(-1 * (var(--h, 44px) + 8px)));
  }
  .pilule:hover .pilule__texte-survol,
  .pilule:focus-visible .pilule__texte-survol {
    opacity: 1;
    transform: translateY(0);
  }
  /* La section où l'on se trouve : pilule remplie de la couleur du thème */
  .pilule[aria-current='true'] {
    border-color: transparent;
    font-weight: 750;
  }
  .pilule[aria-current='true'] .pilule__cercle {
    background: var(--accent);
    transform: translateX(-50%) scale(1.2);
  }
  .pilule[aria-current='true'] .pilule__texte,
  .pilule[aria-current='true'] .pilule__texte-survol {
    color: var(--sur-accent);
  }
  @media (prefers-reduced-motion: reduce) {
    .pilule__cercle,
    .pilule__texte,
    .pilule__texte-survol {
      transition: none;
    }
  }

  /* ---- Outils ---- */
  .outils {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  .outil {
    display: inline-grid;
    place-items: center;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    border-radius: 50%;
    font-family: var(--f-etiquette);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-decoration: none;
    color: var(--encre);
    transition:
      background-color 0.25s,
      transform 0.25s var(--sortie);
  }
  .outil:hover {
    background: color-mix(in oklch, var(--encre) 9%, transparent);
  }
  .outil:active {
    transform: scale(0.92);
  }
  .outil--palette,
  .entete .lecture {
    display: none;
  }

  .lecture--large {
    display: flex;
    margin-block: 0.6rem 0.5rem;
  }
  .lecture--large :global(button) {
    flex: 1;
    padding: 0.7rem 1rem;
    font-size: 0.9375rem;
  }

  /* ---- Volet des thèmes ---- */
  .themes-volet {
    position: fixed;
    inset: calc(var(--entete-h) + 0.5rem) var(--gouttiere) auto auto;
    inline-size: min(22rem, 100vw - 2 * var(--gouttiere));
    margin: 0;
    padding: 1rem;
    border: 1px solid var(--trait);
    border-radius: var(--rayon);
    background: var(--surface);
    color: var(--encre);
    box-shadow: var(--ombre);
    opacity: 0;
    transform: translateY(-0.5rem) scale(0.98);
    transform-origin: 100% 0;
    transition:
      opacity 0.25s var(--sortie),
      transform 0.35s var(--sortie),
      overlay 0.35s allow-discrete,
      display 0.35s allow-discrete;
  }
  .themes-volet:popover-open {
    opacity: 1;
    transform: none;
  }
  @starting-style {
    .themes-volet:popover-open {
      opacity: 0;
      transform: translateY(-0.5rem) scale(0.98);
    }
  }
  .themes-volet .etiquette {
    margin-block-end: 0.75rem;
    color: var(--encre-2);
  }

  /* ---- Menu mobile ---- */
  .menu {
    position: fixed;
    inset: 0;
    inline-size: 100%;
    block-size: 100dvh;
    padding: 0.75rem var(--gouttiere) 2rem;
    background: var(--fond);
    overflow-y: auto;
    overscroll-behavior: contain;
    opacity: 0;
    transform: translateY(-1rem);
    transition:
      opacity 0.3s var(--sortie),
      transform 0.45s var(--sortie),
      overlay 0.45s allow-discrete,
      display 0.45s allow-discrete;
  }
  .menu[open] {
    opacity: 1;
    transform: none;
  }
  @starting-style {
    .menu[open] {
      opacity: 0;
      transform: translateY(-1rem);
    }
  }
  .menu::backdrop {
    background: var(--fond);
  }
  .menu__tete {
    display: flex;
    align-items: center;
    justify-content: space-between;
    block-size: calc(var(--entete-h) - 1.5rem);
    margin-block-end: 1.5rem;
    color: var(--encre-2);
  }
  .menu__liens {
    display: grid;
    margin: 0;
    border-block-start: 1px solid var(--trait);
  }
  .menu__liens a {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-block: 0.95rem;
    border-block-end: 1px solid var(--trait);
    font-family: var(--f-titre);
    font-size: clamp(1.5rem, 6.4vw, 2.1rem);
    font-weight: var(--titre-graisse);
    font-variation-settings: var(--titre-variation);
    letter-spacing: var(--titre-interlettre);
    line-height: 1.1;
    text-decoration: none;
  }
  .menu__reglages {
    display: grid;
    gap: 1.75rem;
    margin-block-start: 2rem;
  }
  .menu__reglages .etiquette {
    color: var(--encre-2);
    margin-block-end: 0.5rem;
  }
  .menu__aide {
    font-size: var(--t-s);
    color: var(--encre-2);
  }

  /* ---- Écrans larges ---- */
  @media (min-width: 40em) {
    .entete .lecture {
      display: inline-flex;
      margin-inline-end: 0.35rem;
    }
    .outil--palette {
      display: inline-grid;
    }
  }
  @media (min-width: 72em) {
    .outil--menu {
      display: none;
    }
  }
  @media (min-width: 88em) {
    .marque__nom {
      display: inline;
    }
  }

  @media print {
    .entete,
    .themes-volet,
    .menu {
      display: none !important;
    }
  }
</style>
