---
/**
 * Haut de page : qui je suis, ce que je cherche, et quand.
 * À gauche : salutation (quatre langues), nom, phrase d'accroche, tableau des départs
 * et boutons. À droite : le billet de stage. En fond : des courbes de niveau animées (WebGL).
 */
import Billet from './Billet.astro';
import Icone from './Icone.astro';
import Niveaux from './Niveaux.astro';
import { ui } from '@/i18n/ui';
import { dateLongue, url, type Langue } from '@/i18n';
import { profil, salutations, stage } from '@/data/profil';

interface Props {
  langue: Langue;
}
const { langue: l } = Astro.props;

// Nombre de jours avant le stage, calculé à la construction puis mis à jour dans le navigateur.
const jours = Math.max(0, Math.ceil((Date.parse(`${stage.debut}T00:00:00Z`) - Date.now()) / 86_400_000));
const cvPdf = url(l === 'fr' ? '/cv/CV_Mamadou_Bailo_Barry_FR.pdf' : '/cv/CV_Mamadou_Bailo_Barry_EN.pdf');
---

<section class="hero" aria-labelledby="titre-hero" data-hero>
  <div class="hero__grille conteneur">
    <div class="hero__texte">
      <p class="hero__salut">
        <span class="pastille" aria-hidden="true">
          <Icone nom="fleche-droite" taille={14} />
        </span>
        <span class="etiquette hero__surtitre">{ui.hero.surtitre[l]}</span>
        <span class="cache-visuel">{ui.hero.salutationsAria[l]}</span>
        <span class="hero__roule" aria-hidden="true">
          <span class="hero__mots">
            {[...salutations, salutations[0]].map((s) => <span lang={s.lang}>{s.texte}</span>)}
          </span>
        </span>
      </p>

      <h1 class="hero__nom" id="titre-hero">
        <span class="masque"><span style="--i: 0">{profil.prenom}</span></span>
        <span class="masque"><span style="--i: 1">{profil.nom}</span></span>
      </h1>

      <div class="hero__accroche">
        <Niveaux texte={ui.hero.accroche} langue={l} />
      </div>

      <!-- La recherche de stage, en une phrase -->
      <p class="disponible">
        <span class="disponible__point" aria-hidden="true"></span>
        <span>
          {ui.hero.disponible[l]} <time datetime={stage.debut}>{dateLongue(stage.debut, l)}</time>
          <span class="disponible__jours" data-jours={stage.debut}>
            ({ui.hero.dans[l]} <span data-jours-texte>{jours}</span> {ui.hero.jours[l]})
          </span>
        </span>
      </p>

      <div class="hero__actions">
        <a class="bouton" href="#projets">
          {ui.hero.voirProjets[l]}
          <Icone nom="fleche-bas" class="vers-le-bas" />
        </a>
        <a class="bouton bouton--contour" href={cvPdf} download>
          <Icone nom="telecharger" />
          {ui.hero.telechargerCv[l]}
        </a>
        <a class="lien hero__contact" href="#contact">
          {ui.hero.contacter[l]}
          <Icone nom="fleche-droite" taille={16} />
        </a>
      </div>
    </div>

    <div class="hero__billet">
      <Billet langue={l} />
    </div>
  </div>
</section>

<script>
  import '@/scripts/hero.ts';
</script>

<style>
  .hero {
    position: relative;
    padding-block: clamp(1.5rem, 4.5vw, 3.5rem) clamp(3rem, 7vw, 6rem);
    overflow: clip;
    isolation: isolate;
  }
  /* Fond : halo statique (toujours présent) + courbes de niveau animées si WebGL est disponible */
  .hero::before {
    content: '';
    position: absolute;
    inset: -20% -10% auto auto;
    inline-size: min(70rem, 110vw);
    aspect-ratio: 1;
    background: radial-gradient(closest-side, color-mix(in oklch, var(--accent) 26%, transparent), transparent);
    z-index: -2;
    pointer-events: none;
  }
  .hero__grille {
    display: grid;
    gap: clamp(2.25rem, 6vw, 4rem);
    align-items: center;
  }
  .hero__texte {
    display: grid;
    gap: clamp(1.1rem, 2.4vw, 1.75rem);
    justify-items: start;
    min-inline-size: 0;
    /* La colonne sert de référence : le nom se dimensionne d'après sa largeur (unité cqi). */
    container-type: inline-size;
  }

  /* Salutation qui défile dans les quatre langues (animation CSS seule) */
  .hero__salut {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.7rem;
    font-family: var(--f-etiquette);
    font-size: var(--t-l);
    font-weight: 600;
  }
  .hero__salut .pastille {
    inline-size: 1.75rem;
    block-size: 1.75rem;
  }
  .hero__roule {
    display: inline-block;
    block-size: 1.5em;
    overflow: clip;
    line-height: 1.5;
    padding-inline-start: 0.8rem;
    border-inline-start: 1px solid var(--trait-fort);
  }
  .hero__mots {
    display: flex;
    flex-direction: column;
    animation: roule 11s var(--va-et-vient) 1.2s infinite;
  }
  .hero__mots span {
    block-size: 1.5em;
    white-space: nowrap;
  }
  @keyframes roule {
    0%,
    19% {
      transform: translateY(0);
    }
    25%,
    44% {
      transform: translateY(-20%);
    }
    50%,
    69% {
      transform: translateY(-40%);
    }
    75%,
    94% {
      transform: translateY(-60%);
    }
    100% {
      transform: translateY(-80%);
    }
  }
  .hero__surtitre {
    color: var(--encre-2);
  }

  /* Le nom, en très grand. Chaque ligne monte derrière un masque. */
  .hero__nom {
    font-size: var(--t-3xl);
    /* La plus grande taille pour laquelle « Mamadou Bailo » tient sur une ligne */
    font-size: min(var(--h1-max), calc(100cqi / var(--h1-rapport)));
    font-weight: var(--titre-graisse);
    font-variation-settings: var(--titre-variation);
    letter-spacing: var(--titre-interlettre);
    line-height: var(--titre-hauteur);
    text-transform: var(--titre-casse);
    margin-block: -0.04em 0;
    max-inline-size: 100%;
  }
  .masque {
    display: block;
    overflow: clip;
    overflow-clip-margin: 0.12em;
    padding-block-end: 0.1em;
    margin-block-end: -0.1em;
  }
  .masque > span {
    display: block;
    animation: monte 1.1s var(--sortie) calc(var(--i) * 0.09s + 0.05s) both;
  }
  @keyframes monte {
    from {
      transform: translateY(105%) rotate(2.5deg);
      transform-origin: 0 100%;
    }
  }

  .hero__accroche {
    font-size: var(--t-l);
    line-height: 1.5;
    max-inline-size: 38rem;
    color: var(--encre-2);
  }

  /* ---- Disponibilité ---- */
  .disponible {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    max-inline-size: 38rem;
    padding: 0.7rem 1rem;
    border-radius: var(--rayon-m);
    background: var(--fond-2);
    border: 1px solid var(--trait);
    font-weight: 600;
    line-height: 1.4;
  }
  .disponible__point {
    flex: none;
    inline-size: 0.6rem;
    block-size: 0.6rem;
    border-radius: 50%;
    background: #1f9d55;
    transform: translateY(-0.05em);
  }
  .disponible__jours {
    font-weight: 500;
    color: var(--encre-2);
    white-space: nowrap;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 0.85rem;
    margin-block-start: 0.35rem;
  }
  .hero__contact {
    padding: 0.6rem 0.4rem;
  }

  .hero__billet {
    display: grid;
    justify-items: center;
    animation: arrive 1.2s var(--sortie) 0.25s both;
  }
  @keyframes arrive {
    from {
      opacity: 0;
      transform: translateY(2.5rem) rotate(3deg);
    }
  }

  @media (min-width: 62em) {
    .hero {
      min-block-size: calc(100svh - var(--entete-h));
      display: grid;
      align-items: center;
    }
    .hero__grille {
      grid-template-columns: minmax(0, 1.5fr) minmax(20rem, 26rem);
    }
    .hero__billet {
      justify-items: end;
    }
  }

  /* Écrans d'ordinateur peu hauts (petits portables) : tout le haut de page reste visible */
  @media (min-width: 62em) and (max-height: 46em) {
    .hero {
      padding-block-start: 1rem;
    }
    .hero__texte {
      gap: 0.95rem;
    }
    .hero__nom {
      font-size: min(calc(var(--h1-max) * 0.78), calc(100cqi / var(--h1-rapport)));
    }
    .hero__accroche {
      font-size: var(--t-m);
    }
  }

  @media (max-width: 47.99em) {
    :global([data-theme='conakry']) .hero__nom {
      --h1-rapport: 5.75;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__roule {
      block-size: auto;
    }
    .hero__mots {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0 0.6em;
      animation: none;
    }
    .hero__mots span:last-child {
      display: none;
    }
    .hero__mots span:not(:nth-last-child(2))::after {
      content: ' ·';
    }
  }
</style>
