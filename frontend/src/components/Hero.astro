---
/**
 * Haut de page : « Bonjour ! Je suis … », ce que je fais, ce que je cherche et quand.
 * À droite, l'ordinateur de Yaroslav Lebedenko (repris avec son accord, public/img/pc.svg) :
 * le logo « </> » flotte, et le bouton rond allume ou éteint l'écran.
 * Le dessin (110 Ko compressé) est chargé après le texte ; sans JavaScript, il s'affiche en image.
 */
import Icone from './Icone.astro';
import Niveaux from './Niveaux.astro';
import { ui } from '@/i18n/ui';
import { dateLongue, url, type Langue } from '@/i18n';
import { profil, stage } from '@/data/profil';

interface Props {
  langue: Langue;
}
const { langue: l } = Astro.props;

// Nombre de jours avant le stage, calculé à la construction puis mis à jour dans le navigateur.
const jours = Math.max(0, Math.ceil((Date.parse(`${stage.debut}T00:00:00Z`) - Date.now()) / 86_400_000));
const cvPdf = url(l === 'fr' ? '/cv/CV_Mamadou_Bailo_Barry_FR.pdf' : '/cv/CV_Mamadou_Bailo_Barry_EN.pdf');
---

<section class="hero" id="accueil" data-section="accueil" aria-labelledby="titre-hero" data-hero>
  <div class="hero__grille conteneur">
    <div class="hero__texte">
      <h1 class="hero__titre" id="titre-hero">
        <span class="hero__bonjour">
          {ui.hero.bonjour[l]}
          <!-- Bébé kangourou 3D qui salue : « baby kangaroo 3d model » (rt699448, CC BY 4.0),
               patte levée et rendu dans Blender (blender/kangourou.py) ; 5 poses dans une planche. -->
          <span class="hero__kangourou" style={`background-image: url(${url('/img/kangourou-salut.webp')})`} aria-hidden="true"></span>
        </span>
        <span class="hero__nom">
          {ui.hero.jeSuis[l]} <span class="hero__nom-accent">{profil.nomComplet}</span>
        </span>
      </h1>

      <div class="hero__accroche">
        <Niveaux texte={ui.hero.accroche} langue={l} />
      </div>

      <!-- La recherche de stage, en une phrase -->
      <p class="disponible">
        <span class="disponible__point" aria-hidden="true"></span>
        <span>
          {ui.hero.disponible[l]} <time datetime={stage.debut}>{dateLongue(stage.debut, l)}</time>
          <span class="disponible__jours" data-jours={stage.debut}>
            ({ui.hero.dans[l]} <span data-jours-texte>{jours}</span> {ui.hero.jours[l]})
          </span>
        </span>
      </p>

      <div class="hero__actions">
        <a class="bouton" href="#projets">
          {ui.hero.voirProjets[l]}
          <Icone nom="fleche-bas" class="vers-le-bas" />
        </a>
        <a class="bouton bouton--contour" href={cvPdf} download>
          <Icone nom="telecharger" />
          {ui.hero.telechargerCv[l]}
        </a>
      </div>
    </div>

    <div class="hero__dessin" data-pc data-libelle={ui.hero.pcLibelle[l]}>
      <img src={url('/img/pc.svg')} alt="" width="3880" height="4662" decoding="async" />
    </div>
  </div>
</section>

<script>
  import '@/scripts/hero.ts';

  // L'ordinateur devient un vrai dessin dans la page (pour le bouton et les couleurs du thème).
  const zone = document.querySelector<HTMLElement>('[data-pc]');
  const image = zone?.querySelector('img');
  if (zone && image) {
    const charger = () =>
      fetch(image.src)
        .then((r) => (r.ok ? r.text() : Promise.reject()))
        .then((texte) => {
          const svg = new DOMParser().parseFromString(texte, 'image/svg+xml').documentElement;
          if (svg.nodeName !== 'svg') return;
          svg.setAttribute('role', 'group');
          svg.setAttribute('aria-label', zone.dataset.libelle ?? '');
          image.replaceWith(svg);
          const bouton = svg.querySelector('[data-ecran-bouton]');
          const basculer = () => svg.classList.toggle('pc--eteint');
          bouton?.addEventListener('click', basculer);
          bouton?.addEventListener('keydown', (e) => {
            const k = (e as KeyboardEvent).key;
            if (k === 'Enter' || k === ' ') {
              e.preventDefault();
              basculer();
            }
          });
        })
        .catch(() => {});
    if ('requestIdleCallback' in window) requestIdleCallback(charger, { timeout: 1500 });
    else setTimeout(charger, 300);
  }
</script>

<style>
  .hero {
    position: relative;
    padding-block: clamp(2rem, 6vw, 5rem) clamp(3rem, 8vw, 6.5rem);
    overflow: clip;
  }
  .hero__grille {
    display: grid;
    gap: clamp(2rem, 6vw, 4rem);
    align-items: center;
  }
  @media (min-width: 60em) {
    .hero__grille {
      grid-template-columns: 1.05fr 1fr;
      min-block-size: min(40rem, calc(100svh - var(--entete-h) - 4rem));
    }
  }

  .hero__texte {
    display: grid;
    gap: clamp(1rem, 2.2vw, 1.5rem);
    justify-items: start;
    min-inline-size: 0;
  }
  .hero__titre {
    display: grid;
    gap: 0.35rem;
    font-family: var(--f-titre);
    font-weight: var(--titre-graisse);
    font-variation-settings: var(--titre-variation);
    letter-spacing: var(--titre-interlettre);
    line-height: 1.08;
    text-wrap: balance;
  }
  /* Le kangourou : une planche de 5 poses (patte de -126° à -174°), affichées l'une après l'autre */
  .hero__kangourou {
    display: inline-block;
    block-size: 2.4em;
    aspect-ratio: 153 / 300;
    margin-inline-start: 0.2em;
    vertical-align: -0.35em;
    background-repeat: no-repeat;
    background-size: 500% 100%;
    background-position: 50% 0; /* pose du milieu (sans animation) */
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero__kangourou {
      animation: kangourou-salue 2.4s step-end 0.6s infinite;
    }
  }
  /* Même rythme que la main : il agite la patte (aller-retour), puis une pause. */
  @keyframes kangourou-salue {
    0% { background-position: 50% 0; }
    5% { background-position: 75% 0; }
    10% { background-position: 100% 0; }
    15% { background-position: 75% 0; }
    20% { background-position: 50% 0; }
    25% { background-position: 25% 0; }
    30% { background-position: 0% 0; }
    35% { background-position: 25% 0; }
    40% { background-position: 50% 0; }
    45% { background-position: 75% 0; }
    50% { background-position: 100% 0; }
    55% { background-position: 75% 0; }
    60%, 100% { background-position: 50% 0; }
  }
  .hero__bonjour {
    font-size: clamp(1.6rem, 1.2rem + 1.8vw, 2.5rem);
  }
  .hero__nom {
    font-size: clamp(2rem, 1.3rem + 3.2vw, 3.6rem);
  }
  .hero__nom-accent {
    color: var(--accent-encre);
  }
  .hero__accroche {
    max-inline-size: 36rem;
    font-size: var(--t-l);
    line-height: 1.6;
    color: var(--encre-2);
  }

  .disponible {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    max-inline-size: 36rem;
    font-weight: 600;
    line-height: 1.5;
  }
  .disponible__point {
    flex: none;
    inline-size: 0.6rem;
    block-size: 0.6rem;
    border-radius: 50%;
    background: oklch(66% 0.17 150);
    box-shadow: 0 0 0 4px oklch(66% 0.17 150 / 0.2);
    transform: translateY(-0.05em);
  }
  .disponible__jours {
    font-weight: 500;
    color: var(--encre-2);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .hero__dessin {
    inline-size: min(100%, 34rem);
    justify-self: center;
    aspect-ratio: 3880 / 4662;
  }
  .hero__dessin > :global(img),
  .hero__dessin > :global(svg) {
    display: block;
    inline-size: 100%;
    block-size: auto;
    overflow: visible;
  }
  /* Comme chez Lebedenko : le logo flotte, devient bleu au survol ; le bouton rond éteint l'écran. */
  .hero__dessin :global(.pc-accent) {
    fill: var(--accent);
  }
  .hero__dessin :global(.pc-ecran) {
    transition: opacity 0.3s;
  }
  .hero__dessin :global(.pc--eteint .pc-ecran) {
    opacity: 0;
  }
  .hero__dessin :global(.pc-bouton) {
    cursor: pointer;
    transition: fill 0.2s;
  }
  .hero__dessin :global(.pc-bouton:hover),
  .hero__dessin :global(.pc-bouton:focus-visible) {
    fill: #147efb;
    outline: none;
  }
  .hero__dessin :global(.pc-logo path) {
    transition: fill 0.2s;
  }
  .hero__dessin :global(.pc-logo path:hover) {
    fill: #147efb;
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero__dessin :global(.pc-logo),
    .hero__dessin :global(.pc-logo-ombre) {
      animation: pc-flotte 4s ease-in-out infinite;
    }
  }
  @keyframes pc-flotte {
    50% {
      transform: translateY(-40px);
    }
  }
  @media (max-width: 59.99em) {
    .hero__dessin {
      inline-size: min(100%, 24rem);
    }
  }
</style>
