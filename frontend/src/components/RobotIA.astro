---
/**
 * Le petit robot de l'assistant IA (bouton en bas à droite). Dessiné pour ce site, en SVG,
 * dans l'esprit d'un « robot flottant » : il flotte, cligne des yeux et sa lumière pulse.
 * Ses couleurs viennent du thème : la lumière (yeux, front, cœur) = --accent,
 * le corps = --surface teintée par l'accent. Décoratif (le bouton porte le nom accessible).
 */
---

<svg class="robot" viewBox="0 0 120 150" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="robot-corps" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" class="robot__corps-clair"></stop>
      <stop offset="1" class="robot__corps-sombre"></stop>
    </linearGradient>
    <radialGradient id="robot-lumiere" cx="0.5" cy="0.4" r="0.6">
      <stop offset="0" class="robot__lumiere-centre"></stop>
      <stop offset="1" class="robot__lumiere-bord"></stop>
    </radialGradient>
  </defs>

  <!-- Ombre au sol : elle rétrécit quand le robot monte -->
  <ellipse class="robot__ombre" cx="60" cy="143" rx="22" ry="4"></ellipse>

  <g class="robot__flotte">
    <!-- Bras (derrière le corps) -->
    <ellipse class="robot__bras robot__bras--g" cx="27" cy="102" rx="10" ry="21" fill="url(#robot-corps)"></ellipse>
    <ellipse class="robot__bras robot__bras--d" cx="93" cy="102" rx="10" ry="21" fill="url(#robot-corps)"></ellipse>

    <!-- Corps en forme d'œuf, avec une couture -->
    <path d="M31 92 C31 74 89 74 89 92 C89 116 78 132 60 132 C42 132 31 116 31 92 Z" fill="url(#robot-corps)"></path>
    <path class="robot__trait" d="M36 98 Q60 84 84 98"></path>
    <!-- Cœur lumineux -->
    <circle cx="60" cy="104" r="9" class="robot__anneau"></circle>
    <circle cx="60" cy="104" r="6.5" fill="url(#robot-lumiere)" class="robot__pouls"></circle>

    <!-- Oreilles -->
    <rect x="12" y="34" width="12" height="22" rx="6" fill="url(#robot-corps)"></rect>
    <rect x="96" y="34" width="12" height="22" rx="6" fill="url(#robot-corps)"></rect>

    <!-- Tête -->
    <rect x="19" y="14" width="82" height="62" rx="30" fill="url(#robot-corps)"></rect>
    <!-- Lumière du front -->
    <path d="M45 14 h30 v4 a6 6 0 0 1 -6 6 h-18 a6 6 0 0 1 -6 -6 z" fill="url(#robot-lumiere)" class="robot__pouls"></path>
    <!-- Visière -->
    <rect x="28" y="29" width="64" height="34" rx="17" class="robot__visiere"></rect>
    <!-- Yeux souriants (demi-lunes) -->
    <g class="robot__yeux">
      <path d="M40 50 a8 7 0 0 1 16 0 z" fill="url(#robot-lumiere)"></path>
      <path d="M64 50 a8 7 0 0 1 16 0 z" fill="url(#robot-lumiere)"></path>
    </g>
  </g>
</svg>

<style>
  .robot {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    overflow: visible;
    --lumiere: var(--accent);
  }
  /* Thème Clair (noir sur blanc) : l'accent est noir, la lumière garde son bleu-cyan d'origine */
  :global([data-theme='clair']) .robot {
    --lumiere: oklch(78% 0.13 210);
  }
  /* Contour léger pour bien détacher le robot des fonds clairs */
  .robot__flotte > :is(path, rect, ellipse) {
    stroke: color-mix(in oklch, var(--encre) 22%, transparent);
    stroke-width: 1;
  }
  .robot__corps-clair {
    stop-color: color-mix(in oklch, white 92%, var(--lumiere));
  }
  .robot__corps-sombre {
    stop-color: color-mix(in oklch, oklch(72% 0.012 260) 85%, var(--lumiere));
  }
  .robot__lumiere-centre {
    stop-color: color-mix(in oklch, white 55%, var(--lumiere));
  }
  .robot__lumiere-bord {
    stop-color: var(--lumiere);
  }
  .robot__visiere {
    fill: oklch(24% 0.04 260);
  }
  .robot__anneau {
    fill: oklch(86% 0.01 260);
    stroke: oklch(70% 0.01 260);
    stroke-width: 1;
  }
  .robot__trait {
    fill: none;
    stroke: oklch(70% 0.01 260 / 0.7);
    stroke-width: 1.2;
  }
  .robot__ombre {
    fill: oklch(20% 0 0 / 0.22);
  }
  .robot__yeux,
  .robot__flotte,
  .robot__ombre,
  .robot__bras {
    transform-box: fill-box;
    transform-origin: center;
  }
  .robot__bras--g {
    transform-origin: 70% 15%;
  }
  .robot__bras--d {
    transform-origin: 30% 15%;
  }
  .robot__pouls {
    filter: drop-shadow(0 0 3px var(--lumiere));
  }

  @media (prefers-reduced-motion: no-preference) {
    .robot__flotte {
      animation: robot-flotte 3s ease-in-out infinite;
    }
    .robot__ombre {
      animation: robot-ombre 3s ease-in-out infinite;
    }
    .robot__yeux {
      animation: robot-cligne 4.5s ease-in-out infinite;
    }
    .robot__pouls {
      animation: robot-pouls 2s ease-in-out infinite;
    }
    .robot__bras--d {
      animation: robot-bras 3s ease-in-out infinite;
    }
    /* Au survol : il fait coucou */
    :global(.assistant__bouton:hover) .robot__bras--d,
    :global(.assistant__bouton:focus-visible) .robot__bras--d {
      animation: robot-coucou 0.6s ease-in-out infinite;
    }
  }
  @keyframes robot-flotte {
    50% {
      transform: translateY(-7px);
    }
  }
  @keyframes robot-ombre {
    50% {
      transform: scale(0.75);
      opacity: 0.6;
    }
  }
  @keyframes robot-cligne {
    0%,
    44%,
    52%,
    100% {
      transform: scaleY(1);
    }
    48% {
      transform: scaleY(0.1);
    }
  }
  @keyframes robot-pouls {
    50% {
      opacity: 0.55;
    }
  }
  @keyframes robot-bras {
    50% {
      transform: rotate(-6deg);
    }
  }
  @keyframes robot-coucou {
    50% {
      transform: rotate(-35deg);
    }
  }
</style>
