---
/**
 * Pied de page, comme celui de Yaroslav Lebedenko : une seule ligne.
 * « © année · Fait avec ❤ par Mamadou Bailo Barry 🚀 » ; le nom (avec la fusée) remonte en haut.
 * En dessous, en petit : le crédit du kangourou 3D (exigé par sa licence CC BY 4.0).
 */
import { ui } from '@/i18n/ui';
import type { Langue } from '@/i18n';
import { profil } from '@/data/profil';

interface Props {
  langue: Langue;
}
const { langue: l } = Astro.props;
const annee = new Date().getFullYear();
const fusee = Object.values(
  import.meta.glob<string>('/src/assets/lebedenko/rocket.svg', { query: '?raw', import: 'default', eager: true }),
)[0]!.replace('<svg', '<svg class="pied__fusee" aria-hidden="true" focusable="false"');
---

<footer class="pied">
  <div class="conteneur">
    <p class="pied__copyright">
      <span>
        © {annee}&nbsp;{ui.pied.faitAvec[l]}&nbsp;<span class="pied__coeur" aria-label={ui.pied.amour[l]}>&#10084;&#xFE0E;</span>&nbsp;{ui.pied.par[l]}&nbsp;
      </span>
      <button type="button" class="pied__nom" data-haut title={ui.pied.haut[l]}>
        {profil.nomComplet}
        <Fragment set:html={fusee} />
      </button>
    </p>
    <p class="pied__credits">
      {ui.pied.main[l][0]}<a href="https://sketchfab.com/3d-models/baby-kangaroo-3d-model-0048d4fce4884357917dc8d3f2bfe684">« baby kangaroo 3d model »</a>{ui.pied.main[l][1]}<a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>{ui.pied.main[l][2]}
      <br />
      {ui.pied.train[l][0]}<a href="https://sketchfab.com/3d-models/07d7a69ffb544ec48442ae3448ee6f1f">« Tangara Sydney Trains T set »</a>{ui.pied.train[l][1]}<a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>{ui.pied.train[l][2]}
    </p>
  </div>
</footer>

<script>
  document.querySelector('[data-haut]')?.addEventListener('click', () => {
    scrollTo({ top: 0 });
    document.querySelector<HTMLElement>('#titre-hero, h1')?.focus?.();
  });
</script>

<style>
  .pied {
    padding-block: 20px;
    background-color: var(--fond-2);
    border-block-start: 1px solid var(--trait);
  }
  .pied__copyright {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    margin: 0;
    text-align: center;
  }
  .pied__coeur {
    display: inline-block;
    vertical-align: middle;
    line-height: 1;
    color: var(--accent-encre);
  }
  .pied__nom {
    display: inline-flex;
    align-items: center;
    min-block-size: 44px;
    font-weight: 500;
    color: inherit;
    transition: 0.2s;
  }
  .pied__nom:hover,
  .pied__nom:focus-visible {
    color: var(--accent-encre);
  }
  .pied__nom :global(.pied__fusee) {
    inline-size: 1.25em;
    block-size: 1.5em;
    margin-inline-start: 3px;
    fill: currentColor;
  }
  .pied__credits {
    margin: 0.25rem auto 0;
    max-inline-size: 60rem;
    font-size: 0.75rem;
    line-height: 1.5;
    text-align: center;
    color: var(--encre-2);
  }
  @media print {
    .pied__credits {
      display: none;
    }
  }
</style>
