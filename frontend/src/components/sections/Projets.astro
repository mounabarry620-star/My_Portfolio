---
/**
 * Projets : les projets en vedette en cartes (image, titre, lien vers le code, phrase, logos),
 * trois visibles et « Voir plus » pour les autres. Puis les autres projets : un globe qui tourne
 * (décoratif) et la même liste en texte, accessible à tous.
 */
import { Picture } from 'astro:assets';
import TitreSection from '../TitreSection.astro';
import Niveaux from '../Niveaux.astro';
import Logo from '../Logo.astro';
import IconeTechno from '../IconeTechno.astro';
import { iconesDe } from '@/data/icones-techno';
import Icone from '../Icone.astro';
import Globe from '../Globe.astro';
import { logosDe } from '@/data/logos';
import { ui } from '@/i18n/ui';
import { routes, type Langue } from '@/i18n';
import { autresRealisations, projets, projetsVedettes } from '@/data/projets';

interface Props {
  langue: Langue;
}
const { langue: l } = Astro.props;
const VISIBLES = 3;
const logos = (technos: string[]) => [...new Set(technos.flatMap((t) => logosDe(t)))].slice(0, 6);
/** Une icône par technologie (la première qui existe), sans doublon. */
const sujets = (technos: string[]) => {
  const vus = new Set<string>();
  return technos.flatMap((nom) => {
    const icone = iconesDe(nom)[0];
    if (!icone) return [];
    const cle = 'skill' in icone ? icone.skill : 'glyphe' in icone ? icone.glyphe : icone.logo;
    if (vus.has(cle)) return [];
    vus.add(cle);
    return [{ nom, icone }];
  });
};
---

<section class="section projets" id="projets" data-section="projets" aria-labelledby="titre-projets">
  <div class="conteneur">
    <TitreSection id="projets" titre={ui.projets.titreCourt[l]} accent={ui.projets.accent[l]} etiquette={ui.projets.sousTitre[l]} />

    <ul class="cartes" role="list" data-cartes>
      {
        projetsVedettes.map((p, i) => {
          const code = p.liens?.find((x) => x.type === 'code');
          const lien = routes.projet(l, p.slug);
          return (
            <li data-en-plus={i >= VISIBLES ? '' : undefined} data-revele style={`--delai: ${(i % 3) * 0.06}s`}>
              <!-- Carte reprise de Yaroslav Lebedenko (avec son accord) -->
              <div class="carte">
                {p.couverture && (
                  <a class="carte__lien-image" href={lien} tabindex="-1" aria-hidden="true">
                    <Picture
                      class="carte__image"
                      src={p.couverture.image}
                      alt=""
                      formats={['avif']}
                      fallbackFormat="webp"
                      widths={[400, 650, 900]}
                      sizes="(min-width: 62em) 26rem, (min-width: 40em) 45vw, 92vw"
                      loading="lazy"
                      decoding="async"
                    />
                  </a>
                )}
                <div class="carte__contenu">
                  <div class="carte__haut">
                    <h3 class="carte__titre">
                      <a class="carte__lien-titre" href={lien}>
                        {p.titre[l]}
                      </a>
                    </h3>
                    {code && (
                      <a class="carte__code" href={code.href} title="GitHub" target="_blank" rel="noopener">
                        <Icone nom="github" taille={24} />
                        <span class="cache-visuel">
                          {ui.projets.code[l]} — {p.titre[l]} {ui.commun.nouvelOnglet[l]}
                        </span>
                      </a>
                    )}
                  </div>
                  <Niveaux texte={p.accroche} langue={l} class="carte__texte" />
                  <ul class="carte__sujets" role="list" aria-label={ui.projets.technologies[l]}>
                    {sujets(p.technologies).map(({ nom, icone }) => (
                      <li title={nom}>
                        <IconeTechno icone={icone} taille={24} />
                        <span class="cache-visuel">{nom}</span>
                      </li>
                    ))}
                  </ul>

                  <div class="carte__fond" aria-hidden="true">
                    <div class="carte__carreaux">
                      {Array.from({ length: 12 }, (_, k) => (
                        <div class={`carreau carreau--${k + 1}`} />
                      ))}
                    </div>
                    <div class="trait trait--1" />
                    <div class="trait trait--2" />
                    <div class="trait trait--3" />
                  </div>
                </div>
                <div class="carte__eclat" aria-hidden="true" />
              </div>
            </li>
          );
        })
      }
    </ul>

    {
      projetsVedettes.length > VISIBLES && (
        <p class="projets__plus">
          <button
            type="button"
            class="voir-plus"
            aria-expanded="false"
            data-voir-plus
            data-plus={ui.projets.voirPlus[l]}
            data-moins={ui.projets.voirMoins[l]}
          >
            {ui.projets.voirPlus[l]}
          </button>
        </p>
      )
    }

    <!-- Les autres projets : le globe (décoratif) + la liste (pour tout le monde) -->
    <div class="autres" id="autres-projets">
      <h3 class="autres__titre" data-revele>{ui.projets.autresTitre[l]}</h3>
      <p class="chapo autres__intro" data-revele>{ui.projets.autresIntro[l]}</p>
      <Globe projets={projets} langue={l} />
      <ul class="autres__liste" role="list">
        {
          autresRealisations.map((p) => (
            <li class="autre" id={`r-${p.slug}`} data-revele>
              <p class="autre__periode">{p.periode[l]}</p>
              <div>
                <h4 class="autre__titre">{p.titre[l]}</h4>
                <Niveaux texte={p.accroche} langue={l} class="autre__texte" />
              </div>
              <ul class="autre__logos" role="list" aria-label={ui.projets.technologies[l]}>
                {logos(p.technologies).map((n) => (
                  <li>
                    <Logo nom={n} taille={18} />
                  </li>
                ))}
                <li class="cache-visuel">{p.technologies.join(', ')}</li>
              </ul>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<script>
  // « Voir plus » : montre ou cache les projets au-delà des trois premiers.
  const bouton = document.querySelector<HTMLButtonElement>('[data-voir-plus]');
  const cartes = document.querySelector<HTMLElement>('[data-cartes]');
  bouton?.addEventListener('click', () => {
    const ouvert = bouton.getAttribute('aria-expanded') !== 'true';
    bouton.setAttribute('aria-expanded', String(ouvert));
    bouton.textContent = (ouvert ? bouton.dataset.moins : bouton.dataset.plus) ?? '';
    cartes?.toggleAttribute('data-ouvert', ouvert);
    if (ouvert) cartes?.querySelector<HTMLAnchorElement>('[data-en-plus] .carte__lien')?.focus();
  });
</script>

<style>
  /* Grille et cartes : reprises de Yaroslav Lebedenko */
  .cartes {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(288px, 100%), 1fr));
    gap: 30px;
    margin: 0;
    padding: 0;
  }
  @media (min-width: 62em) {
    .cartes {
      grid-template-columns: 1fr 1fr 1fr;
    }
  }
  /* Sans JavaScript, tout reste visible ; avec, les cartes en plus attendent « Voir plus ». */
  :global(.js) .cartes:not([data-ouvert]) > [data-en-plus] {
    display: none;
  }

  .carte {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-rows: auto 1fr;
    block-size: 100%;
    overflow: hidden;
    border-radius: 15px;
    background-color: var(--surface);
    box-shadow:
      0 3px 6px rgb(0 0 0 / 0.05),
      0 8px 15px rgb(0 0 0 / 0.1),
      0 0 0 1px var(--trait);
    transition: box-shadow 0.25s;
  }
  .carte:hover,
  .carte:focus-within {
    box-shadow:
      0 3px 6px rgb(0 0 0 / 0.04),
      0 15px 25px rgb(0 0 0 / 0.3),
      0 0 0 1px var(--trait-fort);
  }
  .carte__lien-image {
    display: block;
    margin: 16px 16px 0;
    border-radius: 10px;
  }
  .carte :global(.carte__image) {
    display: block;
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 1.5 / 1;
    object-fit: cover;
    object-position: top center;
    border-radius: 10px;
  }
  .carte__contenu {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    padding: 24px 16px 16px;
    border-radius: 0 0 15px 15px;
  }
  .carte__haut {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-block-end: 10px;
  }
  .carte__titre {
    margin: 0;
    font-size: 1rem;
    font-weight: 800;
  }
  /* Soulignement qui se dessine de gauche à droite au survol */
  .carte__lien-titre {
    position: relative;
    margin-inline-end: 10px;
    text-decoration: none;
    transition: 0.2s;
  }
  .carte__lien-titre::before {
    content: '';
    position: absolute;
    inset-block-start: 100%;
    inset-inline-start: 0;
    inline-size: 0;
    block-size: 2px;
    background-color: var(--accent);
    transition: inherit;
  }
  .carte__lien-titre:hover::before,
  .carte__lien-titre:focus-visible::before {
    inline-size: 100%;
  }
  .carte__code {
    display: block;
    color: var(--encre);
    transition: 0.2s;
  }
  .carte__code:hover,
  .carte__code:focus-visible {
    color: var(--accent-encre);
  }
  .carte :global(.carte__texte) {
    margin-block-end: 10px;
    font-size: 0.875rem;
    color: var(--encre-2);
  }
  .carte__sujets {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 5px 10px;
    margin: auto 0 0;
    padding: 0;
    list-style: none;
  }

  /* Les effets au survol : éclat de couleur, carreaux qui clignotent, lignes qui se dessinent */
  .carte__eclat {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 0;
    z-index: -1;
    inline-size: 100%;
    block-size: 100%;
    border-radius: 50%;
    background-color: var(--accent);
    filter: blur(25px);
    transform: translate(-100%, -100%);
    transition: 0.5s;
  }
  .carte__fond {
    position: absolute;
    inset: 0;
    z-index: -1;
    margin-block-start: -10px;
    mask-image: radial-gradient(circle at 60% 50%, #000 0%, #000 15%, transparent 80%);
  }
  .carte__carreaux {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    opacity: 0;
    transition: opacity 0.25s;
  }
  .carreau {
    inline-size: 100%;
    block-size: 100%;
    background-color: var(--accent);
    opacity: 0;
    animation-duration: 8s;
    animation-iteration-count: infinite;
  }
  .carreau--5,
  .carreau--9,
  .carreau--10 {
    animation-delay: -2s;
  }
  .carreau--1,
  .carreau--2,
  .carreau--6 {
    animation-delay: -4s;
  }
  .carreau--3,
  .carreau--4,
  .carreau--7 {
    animation-delay: -6s;
  }
  .trait {
    position: absolute;
    inset: 0;
  }
  .trait::before,
  .trait::after {
    content: '';
    position: absolute;
    background-color: var(--encre);
    opacity: 0.15;
    transition: transform 0.35s;
  }
  .trait::before {
    inline-size: 100%;
    block-size: 1px;
    transform-origin: 0 50%;
    transform: scaleX(0);
  }
  .trait::after {
    inline-size: 1px;
    block-size: 100%;
    transform-origin: 50% 0;
    transform: scaleY(0);
  }
  .trait--1::before,
  .trait--1::after {
    transition-delay: 0.3s;
  }
  .trait--1::before {
    inset-block-start: 33.3%;
  }
  .trait--1::after {
    inset-inline-start: 25%;
  }
  .trait--2::before,
  .trait--2::after {
    transition-delay: 0.15s;
  }
  .trait--2::before {
    inset-block-start: 66.6%;
  }
  .trait--2::after {
    inset-inline-start: 50%;
  }
  .trait--3::after {
    inset-inline-start: 75%;
  }
  .carte:hover .carte__eclat,
  .carte:focus-within .carte__eclat {
    opacity: 0.6;
    transform: translate(-60%, -60%);
  }
  .carte:hover .carte__carreaux {
    opacity: 0.15;
    transition-delay: 0.25s;
  }
  .carte:hover .trait::before {
    transform: scaleX(1);
  }
  .carte:hover .trait::after {
    transform: scaleY(1);
  }
  .carte:hover .trait--1::before,
  .carte:hover .trait--1::after {
    transition-delay: 0s;
  }
  .carte:hover .trait--2::before,
  .carte:hover .trait--2::after {
    transition-delay: 0.15s;
  }
  .carte:hover .trait--3::before,
  .carte:hover .trait--3::after {
    transition-delay: 0.3s;
  }
  @media (prefers-reduced-motion: no-preference) {
    .carte:hover .carreau {
      animation-name: carreau;
    }
  }
  @keyframes carreau {
    0%,
    12.5%,
    100% {
      opacity: 1;
    }
    25%,
    82.5% {
      opacity: 0;
    }
  }

  /* « Voir plus » : cadre de couleur qui se remplit au survol */
  .projets__plus {
    display: flex;
    justify-content: center;
    margin: 30px 0 0;
  }
  .voir-plus {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-block-size: 2.75rem;
    padding: 10px 30px;
    border: 2px solid var(--accent);
    border-radius: 6px;
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1;
    color: var(--encre);
    transition: 0.2s;
  }
  .voir-plus:hover,
  .voir-plus:focus-visible {
    background-color: var(--accent);
    color: var(--sur-accent);
  }

  /* Autres projets */
  .autres {
    margin-block-start: clamp(4rem, 9vw, 7rem);
    text-align: center;
  }
  .autres__titre {
    font-family: var(--f-titre);
    font-size: var(--t-xl);
    font-weight: var(--sous-titre-graisse);
  }
  .autres__intro {
    margin: 0.75rem auto 0;
  }
  .autres__liste {
    display: grid;
    gap: 0;
    max-inline-size: 56rem;
    margin: 0 auto;
    padding: 0;
    text-align: start;
    border-block-start: 1px solid var(--trait-fort);
  }
  .autre {
    display: grid;
    gap: 0.4rem 1.5rem;
    padding-block: 1.1rem;
    border-block-end: 1px solid var(--trait);
    scroll-margin-block-start: calc(var(--entete-h) + 1rem);
  }
  @media (min-width: 48em) {
    .autre {
      grid-template-columns: 9rem 1fr auto;
      align-items: start;
    }
  }
  .autre__periode {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--encre-2);
  }
  .autre__titre {
    font-size: 1.05rem;
    font-weight: 700;
  }
  .autre :global(.autre__texte) {
    margin-block-start: 0.2rem;
    font-size: 0.9375rem;
    color: var(--encre-2);
  }
</style>
