---
/**
 * Contact : mise en page et icônes de Yaroslav Lebedenko (mail, lieu, GitHub, LinkedIn — avec son accord).
 * À gauche les coordonnées, à droite le formulaire (il prépare un e-mail, rien n'est stocké).
 * Puis les questions fréquentes.
 */
import TitreSection from '../TitreSection.astro';
import Icone from '../Icone.astro';
import { ui } from '@/i18n/ui';
import { url, type Langue } from '@/i18n';
import { faq, profil } from '@/data/profil';

// Icônes de Lebedenko, insérées telles quelles (elles prennent la couleur du texte).
const svg = import.meta.glob<string>('/src/assets/lebedenko/*.svg', { query: '?raw', import: 'default', eager: true });
const icone = (nom: string) =>
  (svg[`/src/assets/lebedenko/${nom}.svg`] ?? '').replace('<svg', '<svg aria-hidden="true" focusable="false"');

interface Props {
  langue: Langue;
}
const { langue: l } = Astro.props;
const courriel = `mailto:${profil.email}?subject=${encodeURIComponent(ui.contact.objetMail[l])}`;
---

<section class="section contact" id="contact" data-section="contact" aria-labelledby="titre-contact">
  <div class="conteneur">
    <div class="contact__grille">
      <div class="contact__infos">
        <TitreSection id="contact" titre={ui.contact.titreCourt[l]} accent={ui.contact.accent[l]} etiquette={ui.contact.etiquette[l]} intro={ui.contact.texte[l]} />

        <div class="infos" data-revele>
          <div class="info">
            <span class="info__icone" set:html={icone('mail')} />
            <div>
              <h3 class="info__titre">{ui.contact.mail[l]}</h3>
              <a class="info__lien" href={courriel}>{profil.email}</a>
            </div>
          </div>
          <div class="info">
            <span class="info__icone"><Icone nom="telephone" taille={30} /></span>
            <div>
              <h3 class="info__titre">{ui.contact.telephone[l]}</h3>
              <a class="info__lien" href={`tel:${profil.telephone.lien}`}>{profil.telephone.affichage}</a>
            </div>
          </div>
          <div class="info">
            <span class="info__icone" set:html={icone('location')} />
            <div>
              <h3 class="info__titre">{ui.contact.lieu[l]}</h3>
              <span>{ui.billet.mobiliteValeur[l]}</span>
            </div>
          </div>
        </div>

        <div class="social" data-revele>
          <a class="social__lien" href={profil.liens.github} title="GitHub" target="_blank" rel="me noopener">
            <span set:html={icone('github')} />
            <span class="cache-visuel">GitHub {ui.commun.nouvelOnglet[l]}</span>
          </a>
          <a class="social__lien" href={profil.liens.linkedin} title="LinkedIn" target="_blank" rel="me noopener">
            <span set:html={icone('linkedin')} />
            <span class="cache-visuel">LinkedIn {ui.commun.nouvelOnglet[l]}</span>
          </a>
          <a class="social__lien social__cv" href={url(l === 'fr' ? '/cv/CV_Mamadou_Bailo_Barry_FR.pdf' : '/cv/CV_Mamadou_Bailo_Barry_EN.pdf')} download>
            <Icone nom="telecharger" taille={24} />
            CV
          </a>
        </div>
      </div>

      <!-- Le formulaire, comme celui de Lebedenko ; il prépare un e-mail dans la messagerie du visiteur. -->
      <form class="formulaire" action={`mailto:${profil.email}`} method="post" enctype="text/plain" data-formulaire data-revele data-objet={ui.contact.objetMail[l]}>
        <label class="champ">
          <span class="cache-visuel">{ui.contact.nom[l]}</span>
          <input class="saisie" name="nom" autocomplete="name" placeholder={ui.contact.nom[l]} required />
        </label>
        <label class="champ">
          <span class="cache-visuel">{ui.contact.email[l]}</span>
          <input class="saisie" name="email" type="email" autocomplete="email" placeholder={ui.contact.email[l]} required />
        </label>
        <label class="champ">
          <span class="cache-visuel">{ui.contact.message[l]}</span>
          <textarea class="saisie" name="message" rows="6" placeholder={ui.contact.message[l]} required></textarea>
        </label>
        <button type="submit" class="envoyer">
          <Icone nom="envoyer" taille={20} />
          {ui.contact.envoyer[l]}
        </button>
        <p class="formulaire__note">{ui.contact.noteEnvoi[l]}</p>
      </form>
    </div>

    <div class="faq" data-revele>
      <h3 class="etiquette">{ui.contact.faqTitre[l]}</h3>
      {
        faq.map((q, i) => (
          <details name="faq" open={i === 0}>
            <summary>
              <span>{q.question[l]}</span>
              <span class="faq__signe" aria-hidden="true" />
            </summary>
            <p>{q.reponse[l]}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<script>
  // Le formulaire ouvre la messagerie du visiteur avec le message déjà écrit.
  const formulaire = document.querySelector<HTMLFormElement>('[data-formulaire]');
  formulaire?.addEventListener('submit', (e) => {
    e.preventDefault();
    const d = new FormData(formulaire);
    const corps = `${d.get('message')}\n\n— ${d.get('nom')} (${d.get('email')})`;
    const objet = formulaire.dataset.objet ?? '';
    location.href = `${formulaire.action}?subject=${encodeURIComponent(objet)}&body=${encodeURIComponent(corps)}`;
  });
</script>

<style>
  .contact__grille {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  @media (min-width: 60em) {
    .contact__grille {
      grid-template-columns: 1fr 1fr;
    }
  }
  .contact__infos :global(.section__tete) {
    margin-block-end: 1.75rem;
  }

  /* Coordonnées (Lebedenko) */
  .infos {
    display: grid;
    align-items: start;
    gap: 20px;
    margin-block-end: 25px;
  }
  .info {
    display: flex;
    align-items: center;
    font-size: 1.2rem;
    line-height: 1.25;
    color: var(--encre-2);
  }
  .info__icone {
    display: grid;
    flex: none;
    inline-size: 30px;
    block-size: 30px;
    margin-inline-end: 15px;
    color: var(--accent-encre);
  }
  .info__icone :global(svg) {
    inline-size: 100%;
    block-size: 100%;
    fill: currentColor;
  }
  .info__titre {
    margin-block-end: 5px;
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--encre);
  }
  .info__lien {
    color: inherit;
    text-decoration: none;
  }
  .info__lien:hover,
  .info__lien:focus-visible {
    text-decoration: underline;
  }
  .social {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
  }
  .social__lien {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-block-size: 44px;
    padding: 5px 10px;
    color: var(--encre-2);
    font-weight: 700;
    text-decoration: none;
    transition: 0.2s;
  }
  .social__lien:first-child {
    padding-inline-start: 0;
  }
  .social__lien :global(svg) {
    inline-size: 24px;
    block-size: 24px;
    fill: currentColor;
  }
  .social__lien:hover,
  .social__lien:focus-visible {
    color: var(--accent-encre);
    transform: translateY(-3px);
  }

  /* Formulaire (Lebedenko) */
  .formulaire {
    display: grid;
    gap: 25px;
  }
  .champ {
    position: relative;
  }
  .saisie {
    inline-size: 100%;
    padding: 15px;
    border: none;
    border-radius: 6px;
    background-color: var(--surface);
    box-shadow: inset 0 0 0 1px var(--trait);
    color: var(--encre);
    font-size: 1.125rem;
    caret-color: var(--accent);
    outline: 2px solid transparent;
    resize: none;
    transition: 0.2s;
  }
  .saisie::placeholder {
    color: var(--encre-2);
  }
  .saisie:hover,
  .saisie:focus-visible {
    outline-color: var(--accent);
  }
  .envoyer {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-inline-size: 150px;
    min-block-size: 44px;
    margin-inline-end: auto;
    padding: 10px 30px;
    border: 2px solid var(--accent);
    border-radius: 6px;
    background-color: transparent;
    color: var(--encre);
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1;
    transition: 0.2s;
  }
  .envoyer:hover,
  .envoyer:focus-visible {
    background-color: var(--accent);
    color: var(--sur-accent);
  }
  .formulaire__note {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--encre-2);
  }

  .faq {
    max-inline-size: 56rem;
    margin: clamp(3rem, 7vw, 5rem) auto 0;
  }
  /* ---- Questions fréquentes : accordéon natif (<details>) ---- */
  .faq > .etiquette {
    padding-block-end: 0.8rem;
    border-block-end: 2px solid var(--encre);
    color: var(--encre-2);
  }
  .faq details {
    border-block-end: 1px solid var(--trait);
    interpolate-size: allow-keywords;
  }
  .faq summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1rem;
    font-weight: 650;
    font-size: var(--t-l);
    line-height: 1.3;
    list-style: none;
  }
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq__signe {
    position: relative;
    flex: none;
    inline-size: 1.75rem;
    block-size: 1.75rem;
    border-radius: 50%;
    border: 1.5px solid var(--trait-fort);
    transition:
      background-color 0.3s,
      border-color 0.3s,
      transform 0.5s var(--ressort);
  }
  .faq__signe::before,
  .faq__signe::after {
    content: '';
    position: absolute;
    inset: 50% auto auto 50%;
    inline-size: 0.7rem;
    block-size: 1.5px;
    background: currentColor;
    translate: -50% -50%;
    transition: rotate 0.4s var(--sortie);
  }
  .faq__signe::after {
    rotate: 90deg;
  }
  .faq details[open] .faq__signe {
    background: var(--accent);
    border-color: transparent;
    color: var(--sur-accent);
    transform: rotate(180deg);
  }
  .faq details[open] .faq__signe::after {
    rotate: 0deg;
  }
  .faq details p {
    padding-block-end: 1.1rem;
    color: var(--encre-2);
    max-inline-size: 38rem;
  }
  /* Ouverture animée (navigateurs récents) */
  .faq details::details-content {
    block-size: 0;
    overflow: clip;
    transition:
      block-size 0.45s var(--sortie),
      content-visibility 0.45s allow-discrete;
  }
  .faq details[open]::details-content {
    block-size: auto;
  }

  @media (min-width: 66em) {
    .contact__grille {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      align-items: start;
    }
  }
</style>
