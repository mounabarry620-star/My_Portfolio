    --s: 1;
    display: flex;
    justify-content: center;
    block-size: calc(38rem * var(--s));
    perspective: 1000px;
  }
  /* La tablette : cadre gris épais, fond très sombre, grande ombre en cascade */
  .tablette {
    inline-size: 64rem;
    flex: none;
    block-size: 30rem;
    padding: 0.5rem;
    transform-origin: 50% 0;
    border: 4px solid #6c6c6c;
    border-radius: 30px;
    background: #222;
    box-shadow:
      0 0 #0000004d,
      0 9px 20px #0000004a,
      0 37px 37px #00000042,
      0 84px 50px #00000026,
      0 149px 60px #0000000a,
      0 233px 65px #00000003;
    will-change: transform;
  }
  .tablette {
    block-size: 38rem;
    margin-block-start: 0;
    padding: 1.5rem;
  }
  .tablette__bord {
    block-size: 100%;
    overflow: hidden;
    padding: 4px;
    border-radius: 16px;
    background: linear-gradient(to bottom right, #6ee7b7, #38bdf8);
  }

  /* ---- VS Code (thème sombre « Dark Modern ») ---- */
  .vscode {
