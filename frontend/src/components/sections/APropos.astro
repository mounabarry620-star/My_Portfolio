    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    block-size: 40rem;
    padding: 0.5rem;
  }
  @media (min-width: 48em) {
    .defile {
      block-size: 80rem;
      padding: 5rem;
    }
  }
  .defile__scene {
    position: relative;
    inline-size: 100%;
    padding-block: 2.5rem;
  }
  @media (min-width: 48em) {
    .defile__scene {
      padding-block: 10rem;
    }
  }
  .apropos__tete :global(.section__tete) {
    margin-block-end: 0;
  }
  .apropos__tete {
    will-change: transform;
  }
  /* La tablette garde toujours sa taille d'ordinateur (64rem) et la même mise en page ;
     sur un écran plus étroit, elle est réduite pour tenir (comme une capture d'écran vivante). */
