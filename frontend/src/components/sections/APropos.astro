---
/**
 * À propos : la tablette de Yeabsira Tarekegn (composant « ContainerScroll » d'Aceternity UI),
 * traduite sans bibliothèque. Elle part inclinée en arrière et se redresse au défilement.
 * Dedans, un vrai VS Code en HTML (pas une capture) : le texte « à propos » écrit comme un
 * composant, et l'image ouverte dans un second onglet.
 * Le texte vient de `particularites` (data/profil.ts) : méthode des « 3 P », 1er P.
 *
 * Image : si un fichier `src/assets/a-propos.{png,jpg,jpeg,webp,avif}` existe, il est affiché ;
 * sinon, c'est le portrait. (Prévu : l'équipage de Luffy, avec une image qu'on a le droit d'utiliser.)
 */
import { Picture } from 'astro:assets';
import TitreSection from '../TitreSection.astro';
import IconeTechno from '../IconeTechno.astro';
import Icone from '../Icone.astro';
import portrait from '@/assets/portrait.jpg';
import { iconesDe } from '@/data/icones-techno';
import { lienRealisation } from '@/data/liens';
import { boiteAOutils } from '@/data/competences';
import { particularites, profil, stage } from '@/data/profil';
import { dateLongue } from '@/i18n';
import { ui } from '@/i18n/ui';
import type { Langue } from '@/i18n';

interface Props {
  langue: Langue;
}
const { langue: l } = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/a-propos.{png,jpg,jpeg,webp,avif}', { eager: true });
const imagePerso = Object.values(images)[0]?.default;
const image = imagePerso ?? portrait;
const alt = imagePerso ? ui.apropos.imageAlt[l] : ui.hero.portraitAlt[l];
const nomImage = imagePerso ? Object.keys(images)[0]!.split('/').pop()! : 'portrait.jpg';

/** Met en couleur les mots-clés d'un paragraphe (sans HTML injecté : on découpe le texte). */
const motsCles = ui.apropos.motsCles[l];
function morceaux(texte: string) {
  const motif = new RegExp(`(${motsCles.map((m) => m.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join('|')})`, 'g');
  return texte.split(motif).map((t) => ({ t, fort: motsCles.includes(t) }));
}

// Tous les outils qui ont un logo, une seule fois chacun.
// Tous les outils qui ont une icône, une seule fois chacun : deux outils avec la même icône
// (PostgreSQL et PL/pgSQL) sont regroupés sous un seul nom.
const cleIcone = (nom: string) =>
  iconesDe(nom)
    .map((i) => ('skill' in i ? i.skill : 'glyphe' in i ? i.glyphe : i.logo))
    .join('+');
const outils = Object.values(
  boiteAOutils
    .flatMap((g) => g.outils)
    .filter((o) => iconesDe(o.nom).length > 0)
    .reduce<Record<string, { nom: string; base: string; utiliseDans: string[] }>>((acc, o) => {
      const k = cleIcone(o.nom);
      acc[k] = acc[k]
        ? { ...acc[k], nom: `${acc[k].nom}, ${o.nom}`, utiliseDans: [...acc[k].utiliseDans, ...o.utiliseDans] }
        : { nom: o.nom, base: o.nom, utiliseDans: o.utiliseDans };
      return acc;
    }, {}),
);
---

<section class="apropos" id="profil" data-section="profil" aria-labelledby="titre-profil">
  <!-- Bloc haut (80rem) : sert de « rail » au mouvement, comme ContainerScroll -->
  <div class="defile" data-apropos>
    <div class="defile__scene">
    <div class="apropos__tete" data-apropos-tete>
      <TitreSection id="profil" titre={ui.apropos.titre[l]} accent={ui.apropos.accent[l]} etiquette={ui.apropos.etiquette[l]} centre />
    </div>

    <!-- La tablette (cadre gris, liseré dégradé) qui se redresse au défilement -->
    <div class="scene3d" data-apropos-cadre>
      <div class="tablette" data-apropos-tablette>
        <div class="tablette__bord">
          <div class="vscode">
            <!-- Barre de titre -->
            <div class="vscode__titre" aria-hidden="true">
              <span class="vscode__points"><i></i><i></i><i></i></span>
              <span class="vscode__menus">File Edit Selection View Go Run Terminal Help</span>
              <span class="vscode__fenetre">APropos.astro — portfolio — Visual Studio Code</span>
            </div>

            <div class="vscode__corps">
              <!-- Barre d'activité -->
              <div class="vscode__activite" aria-hidden="true">
                <span class="actif"><Icone nom="fichiers" taille={22} /></span>
                <span><Icone nom="recherche" taille={22} /></span>
                <span><Icone nom="branche" taille={22} /></span>
                <span><Icone nom="insecte" taille={22} /></span>
                <span><Icone nom="blocs" taille={22} /></span>
                <span class="bas"><Icone nom="compte" taille={22} /></span>
                <span><Icone nom="reglages" taille={22} /></span>
              </div>

              <!-- Explorateur -->
              <div class="vscode__explorateur" aria-hidden="true">
                <p class="vscode__rubrique">Explorer</p>
                <p class="arbre arbre--racine"><Icone nom="chevron-bas" taille={14} /> PORTFOLIO</p>
                <p class="arbre n1"><Icone nom="chevron-bas" taille={14} /> src</p>
                <p class="arbre n2"><Icone nom="chevron-bas" taille={14} /> components</p>
                <p class="arbre n3 actif"><span class="pastille-astro">A</span> APropos.astro</p>
                <p class="arbre n3"><span class="pastille-astro">A</span> Parcours.astro</p>
                <p class="arbre n3"><span class="pastille-astro">A</span> Projets.astro</p>
                <p class="arbre n2"><Icone nom="chevron-droite" taille={14} /> data</p>
                <p class="arbre n2"><Icone nom="chevron-bas" taille={14} /> assets</p>
                <p class="arbre n3"><Icone nom="image" taille={14} /> {nomImage}</p>
                <p class="arbre n1"><Icone nom="chevron-droite" taille={14} /> public</p>
                <p class="arbre n1"><span class="pastille-json">{'{}'}</span> package.json</p>
              </div>

              <!-- L'éditeur : le code (le texte) à gauche, l'image à droite -->
              <div class="vscode__editeur">
                <div class="vscode__volet vscode__volet--code">
                  <p class="vscode__onglets" aria-hidden="true">
                    <span class="onglet actif"><span class="pastille-astro">A</span> APropos.astro</span>
                    <span class="onglet"><Icone nom="fichier-code" taille={14} /> profil.ts</span>
                  </p>
                  <div class="code" tabindex="0" role="region" aria-label="APropos.astro">
                    <p class="c"><span class="l"><span class="m">---</span></span></p>
                    <p class="c"><span class="l"><span class="k">const</span> <span class="v">moi</span> = {'{'}</span></p>
                    <p class="c i1"><span class="l"><span class="p">nom</span>: <span class="s">'{profil.nomComplet}'</span>,</span></p>
                    <p class="c i1"><span class="l"><span class="p">{l === 'fr' ? 'ecole' : 'school'}</span>: <span class="s">'{ui.apropos.ecole[l]}'</span>,</span></p>
                    <p class="c i1"><span class="l">
                      <span class="p">{l === 'fr' ? 'stage' : 'internship'}</span>: <span class="s">'{dateLongue(stage.debut, l)} → {dateLongue(stage.fin, l)}'</span>,
                    </span></p>
                    <p class="c"><span class="l">{'};'}</span></p>
                    <p class="c"><span class="l"><span class="m">---</span></span></p>
                    <p class="c" aria-hidden="true"><span class="l">&nbsp;</span></p>
                    <p class="c"><span class="l"><span class="t">&lt;section</span> <span class="a">id</span>=<span class="s">"a-propos"</span><span class="t">&gt;</span></span></p>
                    {
                      particularites.map((p) => (
                        <>
                          <h3 class="c i1 texte-titre"><span class="l">
                            <span class="t" aria-hidden="true">&lt;h2&gt;</span>
                            {p.titre[l]}
                            <span class="t" aria-hidden="true">&lt;/h2&gt;</span>
                          </span></h3>
                          <p class="c i1 texte"><span class="l">
                            <span class="t" aria-hidden="true">&lt;p&gt;</span>
                            {morceaux(p.texte[l]).map((m) => (m.fort ? <strong>{m.t}</strong> : m.t))}
                            <span class="t" aria-hidden="true">&lt;/p&gt;</span>
                          </span></p>
                        </>
                      ))
                    }
                    <p class="c"><span class="l"><span class="t">&lt;/section&gt;</span></span></p>
                  </div>
                </div>

                <!-- Panneau de chat de l'agent (comme chez Yeabsira) ; l'image y est jointe à un message -->
                <aside class="vscode__volet vscode__chat">
                  <p class="vscode__onglets" aria-hidden="true">
                    <span class="onglet actif">CHAT</span>
                  </p>
                  <div class="chat__corps">
                    <div class="chat__accueil" aria-hidden="true">
                      <Icone nom="bulle" taille={22} />
                      <p class="chat__titre">Build with Agent</p>
                      <p class="chat__note">AI responses may be inaccurate.</p>
                    </div>
                    <figure class="chat__message">
                      <figcaption>{ui.apropos.messageImage[l]}</figcaption>
                      <div class="chat__piece">
                        <Picture
                          src={image}
                          alt={alt}
                          formats={['avif']}
                          fallbackFormat="webp"
                          widths={[240, 360, 520]}
                          sizes="(min-width: 64em) 15rem, 60vw"
                          loading="lazy"
                          decoding="async"
                        />
                        <span class="chat__fichier" aria-hidden="true"><Icone nom="image" taille={12} /> {nomImage}</span>
                      </div>
                    </figure>
                  </div>
                  <div class="chat__saisie" aria-hidden="true">
                    <span class="chat__champ">Describe what to build next</span>
                    <span class="chat__options"><span>Agent ⌄</span><span>Auto ⌄</span><Icone nom="envoyer" taille={14} /></span>
                  </div>
                </aside>
              </div>
            </div>

            <!-- Barre d'état -->
            <p class="vscode__etat" aria-hidden="true">
              <span class="distant">&gt;&lt;</span>
              <span><Icone nom="branche" taille={13} /> main*</span>
              <span>⊗ 0 ⚠ 0</span>
              <span>You, 20 seconds ago</span>
              <span class="droite">Ln 12, Col 4</span>
              <span>Spaces: 2</span>
              <span>UTF-8</span>
              <span>LF</span>
              <span>Astro</span>
              <span><Icone nom="cloche" taille={13} /></span>
            </p>
          </div>
        </div>
      </div>
    </div>

    </div>
  </div>

  <div class="conteneur">
    <!-- Sur téléphone, le texte de la tablette est petit : on peut le lire en grand ici. -->
    <details class="lire-grand">
      <summary>{ui.apropos.lireGrand[l]}</summary>
      <div class="lire-grand__texte">
        {
          particularites.map((p) => (
            <>
              <h3>{p.titre[l]}</h3>
              <p>{p.texte[l]}</p>
            </>
          ))
        }
      </div>
    </details>

    <!-- Les outils : des icônes seules, comme chez Lebedenko ; au survol, un halo de couleur. -->
    <div class="outils">
      <h3 class="outils__titre" data-revele>{ui.apropos.outils[l]}</h3>
      <ul class="outils__liste" role="list" data-revele>
        {
          outils.map((o) => {
            const projet = o.utiliseDans.map((id) => lienRealisation(l, id)).find(Boolean);
            const contenu = (
              <>
                {iconesDe(o.base).map((ic) => (
                  <IconeTechno icone={ic} taille={50} />
                ))}
                <span class="cache-visuel">{o.nom}</span>
              </>
            );
            return (
              <li>
                {projet ? (
                  <a class="outil" href={projet} title={o.nom}>
                    {contenu}
                  </a>
                ) : (
                  <span class="outil" title={o.nom}>
                    {contenu}
                  </span>
                )}
              </li>
            );
          })
        }
      </ul>
    </div>
  </div>
</section>

<script>
  // Mouvement de ContainerScroll (useScroll de framer-motion, réglages par défaut) :
  // la tablette reste couchée à 20°, puis s'aplatit jusqu'à 0° ; le titre remonte de 100 px.
  const zone = document.querySelector<HTMLElement>('[data-apropos]');
  const tablette = document.querySelector<HTMLElement>('[data-apropos-tablette]');
  const tete = document.querySelector<HTMLElement>('[data-apropos-tete]');
  const cadre = document.querySelector<HTMLElement>('[data-apropos-cadre]');
  // Réduction pour tenir dans la largeur disponible (1 sur un grand écran).
  let reduction = 1;
  const reduire = () => {
    if (!cadre || !tablette) return;
    // petite marge sur les côtés quand elle est réduite (elle grossit un peu au début du mouvement)
    reduction = Math.min(1, (cadre.clientWidth * (cadre.clientWidth < tablette.offsetWidth ? 0.94 : 1)) / tablette.offsetWidth);
    cadre.style.setProperty('--s', reduction.toFixed(4));
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) tablette.style.transform = `scale(${reduction})`;
  };
  reduire();
  addEventListener('resize', reduire);
  if (zone && tablette && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let attente = false;
    const maj = () => {
      attente = false;
      const r = zone.getBoundingClientRect();
      // 0 tant que le haut du bloc n'a pas atteint le haut de l'écran, 1 quand son bas touche le bas de l'écran.
      const p = Math.min(1, Math.max(0, -r.top / Math.max(1, r.height - innerHeight)));
      const echelle = (1.05 - 0.05 * p) * reduction;
      tablette.style.transform = `rotateX(${20 * (1 - p)}deg) scale(${echelle})`;
      if (tete) tete.style.transform = `translateY(${-100 * p}px)`;
    };
    const demander = () => {
      if (!attente) {
        attente = true;
        requestAnimationFrame(maj);
      }
    };
    addEventListener('scroll', demander, { passive: true });
    addEventListener('resize', demander);
    maj();
  }
</script>

<style>
