---
/** Section 01 — Particularités : trois faits qui distinguent le profil, chacun avec sa preuve. */
import TitreSection from '../TitreSection.astro';
import Icone from '../Icone.astro';
import { ui } from '@/i18n/ui';
import { routes, type Langue } from '@/i18n';
import { particularites } from '@/data/profil';
import { lienRealisation } from '@/data/liens';

interface Props {
  langue: Langue;
}
const { langue: l } = Astro.props;

const cible = (p: (typeof particularites)[number]) => {
  if (!p.lien) return undefined;
  return 'projet' in p.lien ? lienRealisation(l, p.lien.projet) : routes.section(l, p.lien.section);
};
---

<section class="section" id="profil" data-section="profil" aria-labelledby="titre-profil">
  <div class="conteneur">
    <TitreSection
      numero={1}
      id="profil"
      etiquette={ui.particularites.etiquette[l]}
      titre={ui.particularites.titre[l]}
      intro={ui.particularites.intro[l]}
    />

    <ol class="faits" role="list">
      {
        particularites.map((p, i) => (
          <li class="fait" data-revele style={`--delai: ${i * 0.09}s`}>
            <span class="fait__numero" aria-hidden="true">
              {i + 1}
            </span>
            <h3 class="titre-3">{p.titre[l]}</h3>
            <p class="fait__texte">{p.texte[l]}</p>
            <p class="fait__preuve">
              <Icone nom="preuve" taille={18} />
              <span>
                <strong class="etiquette">{ui.commun.preuve[l]}</strong>
                {cible(p) ? <a href={cible(p)}>{p.preuve[l]}</a> : p.preuve[l]}
              </span>
            </p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .faits {
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
    margin: 0;
  }
  .fait {
    position: relative;
    display: grid;
    align-content: start;
    gap: 0.85rem;
    padding-block-start: 1.35rem;
    border-block-start: 2px solid var(--encre);
  }
  /* Grand chiffre en filigrane, dans la police de titre du thème */
  .fait__numero {
    font-family: var(--f-titre);
    font-size: clamp(3.5rem, 7vw, 5.5rem);
    font-weight: var(--titre-graisse);
    font-variation-settings: var(--titre-variation);
    line-height: 0.8;
    letter-spacing: -0.05em;
    color: var(--accent-encre);
    margin-block-end: 0.5rem;
  }
  .fait__texte {
    color: var(--encre-2);
    max-inline-size: 34rem;
  }
  .fait__preuve {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    margin-block-start: 0.35rem;
    padding: 0.85rem 1rem;
    border-radius: var(--rayon-m);
    background: var(--fond-2);
    font-size: var(--t-s);
    line-height: 1.45;
  }
  .fait__preuve :global(svg) {
    flex: none;
    margin-block-start: 0.1rem;
    color: var(--accent-encre);
  }
  .fait__preuve .etiquette {
    display: block;
    font-size: 0.625rem;
    color: var(--encre-2);
    margin-block-end: 0.15rem;
  }
  .fait__preuve a {
    font-weight: 600;
    text-decoration-color: color-mix(in oklch, currentColor 40%, transparent);
  }
  .fait__preuve a:hover {
    text-decoration-color: currentColor;
  }
  @media (min-width: 54em) {
    .faits {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
