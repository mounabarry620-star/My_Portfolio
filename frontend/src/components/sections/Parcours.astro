---
/**
 * Parcours : la frise de Yeabsira Tarekegn (composant d'origine « Timeline » d'Aceternity UI),
 * traduite sans bibliothèque. La date reste collée en haut pendant qu'on lit l'étape.
 * Du plus ancien au plus récent. La voie a deux lignes (Ligne 1 « Sciences et mécanique »,
 * Ligne 2 « Informatique ») reliées par la gare de correspondance (2025).
 * La ligne est une voie ferrée, chaque date une gare : au défilement, un train 3D descend
 * de gare en gare (il s'arrête à chacune, phares allumés quand il roule), en glissant à vitesse limitée.
 * Train : « Tangara Sydney Trains T set » (TheOminousDuck, CC BY 4.0), repeint et rendu dans
 * Blender (blender/train/) en 3 couches : carrosserie, livrée (couleur du thème), lumières.
 * Les étapes (data/parcours.ts) vont du plus récent au plus ancien, les objectifs en tête.
 */
import TitreSection from '../TitreSection.astro';
import { ui } from '@/i18n/ui';
import type { Langue } from '@/i18n';
import { etapes, lignes } from '@/data/parcours';
import { lienRealisation } from '@/data/liens';
import { url } from '@/i18n';

interface Props {
  langue: Langue;
}
const { langue: l } = Astro.props;
// Du plus ancien au plus récent : le train avance dans le temps, de Conakry vers le stage.
const liste = etapes;
const numeroLigne = { conakry: 1, arles: 2 } as const;
/** Première étape de chaque ligne : on y affiche le panneau de la ligne. */
const debutLigne = (i: number) => i === 0 || liste[i - 1]!.ligne !== liste[i]!.ligne;
const avantCorrespondance = liste[liste.findIndex((e) => e.genre === 'correspondance') - 1]?.ligne ?? 'conakry';
---

<section class="section parcours" id="parcours" data-section="parcours" aria-labelledby="titre-parcours">
  <div class="conteneur">
    <TitreSection id="parcours" titre={ui.parcours.titreCourt[l]} accent={ui.parcours.accent[l]} etiquette={ui.parcours.sousTitre[l]} centre />
  </div>

  <div class="frise" data-frise>
    <ol class="frise__liste" role="list" data-frise-liste>
      {
        liste.map((e, i) => (
          <li
            class:list={['etape', `etape--ligne-${numeroLigne[e.ligne]}`, { 'etape--futur': e.futur, 'etape--correspondance': e.genre === 'correspondance' }]}
          >
            <span class="etape__point" aria-hidden="true" data-gare data-correspondance={e.genre === 'correspondance' ? '' : undefined}>
              <span />
            </span>
            <div class="etape__gauche">
              <p class="etape__date">{e.dates[l]}</p>
            </div>
            <div class="etape__droite">
              <p class="etape__date etape__date--mobile" aria-hidden="true">
                {e.dates[l]}
              </p>
              {e.genre === 'correspondance' ? (
                <div class="tableau">
                  <p class="tableau__titre">{ui.parcours.correspondance[l]}</p>
                  <p class="tableau__lignes">
                    <span class="pastille-ligne pastille-ligne--1">{numeroLigne[avantCorrespondance]}</span>
                    {lignes[avantCorrespondance].note[l]}
                    <span aria-hidden="true">→</span>
                    <span class="cache-visuel">{l === 'fr' ? 'vers' : 'to'}</span>
                    <span class="pastille-ligne pastille-ligne--2">{numeroLigne[e.ligne]}</span>
                    {lignes[e.ligne].note[l]}
                  </p>
                </div>
              ) : (
                <>
                  {debutLigne(i) && (
                    <p class={`panneau-ligne panneau-ligne--${numeroLigne[e.ligne]}`}>
                      <span class={`pastille-ligne pastille-ligne--${numeroLigne[e.ligne]}`}>{numeroLigne[e.ligne]}</span>
                      {lignes[e.ligne].nom[l]} · {lignes[e.ligne].note[l]}
                    </p>
                  )}
                  <p class="etape__genre">{ui.parcours[e.genre][l]}</p>
                </>
              )}
              <h3 class="etape__titre">{e.titre[l]}</h3>
              <p class="etape__lieu">{e.lieu[l]}</p>
              {e.texte && <p class="etape__texte">{e.texte[l]}</p>}
              {e.projet && (
                <a class="lien etape__lien" href={lienRealisation(l, e.projet)}>
                  {ui.projets.fiche[l]} →
                </a>
              )}
            </div>
          </li>
        ))
      }
    </ol>
    <!-- La voie : Ligne 1 jusqu'à la correspondance, Ligne 2 ensuite (--coupure posé par le script) -->
    <div class="frise__ligne" aria-hidden="true" data-voie>
      <span class="voie voie--1"></span>
      <span class="voie voie--2"></span>
    </div>
    <!-- Le train (décoratif) : 3 couches superposées -->
    <div class="train" data-train aria-hidden="true">
      <img class="train__base" src={url('/img/train-base.webp')} alt="" width="189" height="700" decoding="async" />
      <span class="train__livree" style={`--masque: url(${url('/img/train-livree.webp')})`}></span>
      <img class="train__lumiere" src={url('/img/train-lumiere.webp')} alt="" width="189" height="700" decoding="async" />
      <span class="train__faisceau"></span>
    </div>
  </div>
</section>

<script>
  // Le train : le défilement fixe sa DESTINATION (une gare ou un point entre deux gares),
  // puis le train y glisse doucement, à vitesse limitée : il ne saute jamais d'un cran de molette.
  // Repère : le point situé à 45 % de la hauteur de l'écran. Sur chaque trajet entre deux gares,
  // le train attend en gare sur les premiers 20 % du défilement, puis roule.
  const frise = document.querySelector<HTMLElement>('[data-frise]');
  const train = document.querySelector<HTMLElement>('[data-train]');
  const gares = [...document.querySelectorAll<HTMLElement>('[data-gare]')];
  const voie = document.querySelector<HTMLElement>('[data-voie]');
  const iCorrespondance = gares.findIndex((g) => g.hasAttribute('data-correspondance'));
  if (frise && train && gares.length > 1) {
    const calme = matchMedia('(prefers-reduced-motion: reduce)');
    let positions: number[] = [];
    const mesurer = () => {
      const haut = frise.getBoundingClientRect().top;
      positions = gares.map((g) => {
        const r = g.getBoundingClientRect();
        return r.top - haut + r.height / 2;
      });
      if (voie && iCorrespondance >= 0) voie.style.setProperty('--coupure', `${positions[iCorrespondance]}px`);
    };
    const lisse = (t: number) => t * t * (3 - 2 * t);

    /** Où le train doit aller, d'après le défilement. */
    const destination = () => {
      const repere = innerHeight * 0.45 - frise.getBoundingClientRect().top;
      const n = positions.length;
      if (repere <= positions[0]!) return positions[0]!;
      if (repere >= positions[n - 1]!) return positions[n - 1]!;
      for (let i = 0; i < n - 1; i++) {
        const a = positions[i]!, b = positions[i + 1]!;
        if (repere < b) {
          // À la correspondance, le train reste plus longtemps à quai (45 % du trajet au lieu de 20 %).
          const attente = i === iCorrespondance ? 0.45 : 0.2;
          const u = Math.min(1, Math.max(0, ((repere - a) / (b - a) - attente) / (0.9 - attente)));
          return a + (b - a) * (calme.matches ? Math.round(u) : lisse(u));
        }
      }
      return positions[n - 1]!;
    };

    let y = 0;
    let vise = 0;
    let anime = false;
    let avant = 0;
    let signale = false;
    const poser = () => {
      train.style.setProperty('--y', `${y.toFixed(1)}px`);
      // Couleur de la ligne : Ligne 1 avant la correspondance, Ligne 2 à partir d'elle.
      if (iCorrespondance >= 0) {
        const c = positions[iCorrespondance]!;
        train.dataset.ligne = y < c - 4 ? '1' : '2';
        // En gare de correspondance : les phares clignotent deux fois (une fois par arrêt).
        const aQuai = Math.abs(y - c) < 3;
        if (aQuai && !signale && !calme.matches) {
          signale = true;
          train.classList.remove('train--signal');
          void train.offsetWidth;
          train.classList.add('train--signal');
        } else if (!aQuai) signale = false;
      }
    };
    const image = (t: number) => {
      const dt = Math.min(0.05, (t - avant) / 1000);
      avant = t;
      const ecart = vise - y;
      // Approche douce (amortie) avec une vitesse maximale : environ 1,5 s entre deux gares.
      const vmax = Math.max(220, Math.abs(ecart) * 0.6);
      const pas = Math.sign(ecart) * Math.min(Math.abs(ecart) * (1 - Math.exp(-dt * 2.2)), vmax * dt);
      y += pas;
      poser();
      const roule = Math.abs(ecart) > 2;
      train.toggleAttribute('data-roule', roule);
      if (roule) requestAnimationFrame(image);
      else {
        y = vise;
        poser();
        anime = false;
      }
    };
    const maj = () => {
      vise = destination();
      if (calme.matches) {
        y = vise;
        poser();
        return;
      }
      if (!anime) {
        anime = true;
        avant = performance.now();
        requestAnimationFrame(image);
      }
    };

    mesurer();
    y = vise = destination();
    poser();
    requestAnimationFrame(() => train.classList.add('train--pret'));
    addEventListener('scroll', maj, { passive: true });
    const remesurer = () => {
      mesurer();
      maj();
    };
    addEventListener('resize', remesurer);
    document.fonts?.ready.then(remesurer);
    new ResizeObserver(remesurer).observe(frise);
  }
</script>

<style>
  .frise {
    position: relative;
    inline-size: 100%;
    max-inline-size: min(80rem, 100% - 2 * var(--reserve-menu));
    margin: 0 auto;
    padding-block-end: 5rem;
  }
  @media (min-width: 48em) {
    .frise {
      padding-inline: 2.5rem;
    }
  }
  .frise__liste {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .etape {
    --haut: 2.5rem;
    position: relative;
    display: flex;
    justify-content: flex-start;
    padding-block-start: var(--haut);
  }
  @media (min-width: 48em) {
    .etape {
      --haut: 10rem;
      gap: 2.5rem;
    }
    .etape:first-child {
      --haut: 2.5rem;
    }
  }

  /* À gauche : le point et la date, collés en haut de l'écran pendant la lecture */
  .etape__gauche {
    position: sticky;
    inset-block-start: 10rem;
    z-index: 4;
    display: flex;
    flex-direction: column;
    align-items: center;
    align-self: flex-start;
    max-inline-size: 20rem;
  }
  @media (min-width: 48em) {
    .etape__gauche {
      flex-direction: row;
      inline-size: 100%;
    }
  }
  @media (min-width: 64em) {
    .etape__gauche {
      max-inline-size: 24rem;
    }
  }
  /* La gare : un rond sur la voie, au niveau de la date */
  .etape__point {
    position: absolute;
    inset-block-start: var(--haut);
    inset-inline-start: 0.75rem;
    z-index: 2;
    display: grid;
    place-items: center;
    inline-size: 2.5rem;
    block-size: 2.5rem;
    border-radius: 50%;
    background: color-mix(in oklch, var(--encre) 45%, var(--fond));
  }
  :global([data-theme='sombre']) .etape__point {
    background: #000;
  }
  .etape__point > span {
    inline-size: 1rem;
    block-size: 1rem;
    border-radius: 50%;
    background: var(--fond-2);
    border: 1px solid var(--trait-fort);
  }
  .etape--futur .etape__point > span {
    background: var(--accent);
  }
  .etape__date {
    display: none;
    margin: 0;
    font-family: var(--f-texte);
    font-size: 3rem;
    font-weight: 800;
    line-height: 1.05;
    color: var(--encre-2);
  }
  @media (min-width: 48em) {
    .etape__gauche .etape__date {
      display: block;
      padding-inline-start: 5rem;
    }
  }

  /* À droite : l'étape */
  .etape__droite {
    position: relative;
    inline-size: 100%;
    padding-inline: 5rem 1rem;
  }
  @media (min-width: 48em) {
    .etape__droite {
      padding-inline-start: 1rem;
    }
  }
  .etape__date--mobile {
    display: block;
    margin-block-end: 0.75rem;
    font-size: 1.5rem;
  }
  @media (min-width: 48em) {
    .etape__date--mobile {
      display: none;
    }
  }
  .etape__genre {
    margin: 0 0 0.5rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: var(--etiquette-interlettre);
    text-transform: uppercase;
    color: var(--accent-encre);
  }
  .etape__titre {
    margin-block-end: 0.75rem;
    font-family: var(--f-titre);
    font-size: clamp(1.75rem, 1.2rem + 2.2vw, 3rem);
    font-weight: var(--sous-titre-graisse);
    font-variation-settings: var(--titre-variation);
    line-height: 1.1;
  }
  .etape__lieu {
    margin: 0 0 1rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--encre-2);
  }
  .etape__texte {
    margin: 0 0 1.5rem;
    max-inline-size: 44rem;
    font-size: 0.875rem;
    line-height: 1.7;
  }

  /* Couleurs des deux lignes (elles suivent le thème) */
  .parcours {
    --ligne-1: var(--accent-2);
    --ligne-2: var(--accent);
  }
  /* La voie : deux rails et des traverses, qui s'effacent en haut et en bas ;
     rails de la couleur de la Ligne 1 jusqu'à la correspondance, de la Ligne 2 ensuite. */
  .frise__ligne {
    --coupure: 50%;
    --traverse: color-mix(in oklch, var(--encre) 14%, var(--fond));
    position: absolute;
    inset-block: 0;
    inset-inline-start: calc(2rem - 13px);
    inline-size: 26px;
    mask-image: linear-gradient(to bottom, transparent 0%, #000 6%, #000 94%, transparent 100%);
  }
  .voie {
    position: absolute;
    inset-inline: 0;
    background:
      linear-gradient(90deg, transparent 4px, var(--rail) 4px 6px, transparent 6px 20px, var(--rail) 20px 22px, transparent 22px),
      repeating-linear-gradient(180deg, var(--traverse) 0 4px, transparent 4px 12px);
  }
  .voie--1 {
    --rail: color-mix(in oklch, var(--ligne-1) 80%, var(--encre));
    inset-block: 0 calc(100% - var(--coupure));
  }
  .voie--2 {
    --rail: color-mix(in oklch, var(--ligne-2) 80%, var(--encre));
    inset-block: var(--coupure) 0;
  }

  /* Panneau de quai au début de chaque ligne */
  .panneau-ligne {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.75rem;
    padding: 0.3rem 0.75rem 0.3rem 0.3rem;
    border-radius: 999px;
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--trait);
    font-size: 0.8125rem;
    font-weight: 700;
  }
  .pastille-ligne {
    display: inline-grid;
    place-items: center;
    inline-size: 1.6rem;
    block-size: 1.6rem;
    border-radius: 50%;
    font-size: 0.8125rem;
    font-weight: 800;
    color: var(--sur-accent);
  }
  .pastille-ligne--1 {
    background: var(--ligne-1);
    color: oklch(15% 0 0);
  }
  .pastille-ligne--2 {
    background: var(--ligne-2);
  }

  /* Tableau d'affichage de la correspondance (style panneau de gare) */
  .tableau {
    display: grid;
    gap: 0.5rem;
    max-inline-size: 30rem;
    margin-block-end: 1rem;
    padding: 0.9rem 1.1rem;
    border-radius: 10px;
    background: oklch(22% 0.06 262);
    color: white;
    box-shadow: var(--ombre);
  }
  .tableau__titre {
    margin: 0;
    font: 800 0.8125rem/1 var(--mono-systeme);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: oklch(86% 0.16 90);
  }
  .tableau__lignes {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    margin: 0;
    font-size: 0.9375rem;
    font-weight: 600;
  }

  /* La gare de correspondance : un gros double rond, moitié Ligne 1, moitié Ligne 2 */
  .etape--correspondance .etape__point {
    inset-inline-start: 0.5rem;
    inline-size: 3rem;
    block-size: 3rem;
    margin-block-start: -0.25rem;
    background: conic-gradient(from -90deg, var(--ligne-1) 0 50%, var(--ligne-2) 50% 100%);
    box-shadow: 0 0 0 3px var(--fond);
  }
  .etape--correspondance .etape__point > span {
    inline-size: 1.5rem;
    block-size: 1.5rem;
    background: var(--fond);
    border: 3px solid var(--encre);
  }
  @media (min-width: 48em) {
    .frise__ligne {
      inset-inline-start: calc(2.5rem + 2rem - 13px);
    }
  }

  /* Le train : posé sur la voie, centré sur sa position --y */
  .train {
    --l: 2.6rem;
    --y: 0px;
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: calc(2rem - var(--l) / 2);
    z-index: 3;
    inline-size: var(--l);
    aspect-ratio: 189 / 700;
    transform: translateY(calc(var(--y) - 50%));
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.4s;
    --faisceau: rgb(255 222 140 / 0.35);
  }
  .train--pret {
    opacity: 1;
  }
  @media (min-width: 48em) {
    .train {
      --l: 4rem;
      inset-inline-start: calc(2.5rem + 2rem - var(--l) / 2);
    }
  }
  :global([data-theme='sombre']) .train {
    --faisceau: rgb(255 235 190 / 0.5);
  }
  .train__base,
  .train__livree,
  .train__lumiere {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
  }
  /* La livrée prend la couleur du thème (masque blanc + couleur) */
  .train__livree {
    background: var(--ligne-2);
    transition: background-color 0.8s ease;
    mask: var(--masque) center / 100% 100% no-repeat;
  }
  /* Les lumières : fenêtres toujours un peu allumées, phares quand il roule */
  .train__lumiere {
    mix-blend-mode: plus-lighter;
    opacity: 0.35;
    transition: opacity 0.35s;
  }
  /* Le faisceau des phares, sur la voie devant le train */
  .train__faisceau {
    position: absolute;
    inset: 91% auto auto 50%;
    inline-size: 150%;
    block-size: 70%;
    background: linear-gradient(var(--faisceau), transparent 90%);
    clip-path: polygon(40% 0, 60% 0, 100% 100%, 0 100%);
    transform: translateX(-50%);
    opacity: 0;
    transition: opacity 0.35s;
  }
  .train[data-ligne='1'] .train__livree {
    background: var(--ligne-1);
  }
  /* Signal à la correspondance : deux éclats des phares */
  .train--signal .train__lumiere,
  .train--signal .train__faisceau {
    animation: train-signal 1.3s ease-in-out;
  }
  @keyframes train-signal {
    0%,
    40%,
    100% {
      opacity: 0.35;
    }
    15%,
    60% {
      opacity: 1;
    }
  }
  .train[data-roule] .train__lumiere,
  .train[data-roule] .train__faisceau {
    opacity: 1;
  }
</style>
