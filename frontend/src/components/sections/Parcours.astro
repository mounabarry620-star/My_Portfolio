---
/**
 * Parcours : la frise de Yeabsira Tarekegn (composant d'origine « Timeline » d'Aceternity UI),
 * traduite sans bibliothèque. La date reste collée en haut pendant qu'on lit l'étape ;
 * une ligne de couleur se remplit au fil du défilement.
 * Les étapes (data/parcours.ts) vont du plus récent au plus ancien, les objectifs en tête.
 */
import TitreSection from '../TitreSection.astro';
import { ui } from '@/i18n/ui';
import type { Langue } from '@/i18n';
import { etapes } from '@/data/parcours';
import { lienRealisation } from '@/data/liens';

interface Props {
  langue: Langue;
}
const { langue: l } = Astro.props;
const liste = [...etapes].reverse();
---

<section class="section parcours" id="parcours" data-section="parcours" aria-labelledby="titre-parcours">
  <div class="conteneur">
    <TitreSection id="parcours" titre={ui.parcours.titreCourt[l]} accent={ui.parcours.accent[l]} etiquette={ui.parcours.sousTitre[l]} centre />
  </div>

  <div class="frise" data-frise>
    <ol class="frise__liste" role="list" data-frise-liste>
      {
        liste.map((e) => (
          <li class:list={['etape', { 'etape--futur': e.futur }]}>
            <div class="etape__gauche">
              <span class="etape__point" aria-hidden="true">
                <span />
              </span>
              <p class="etape__date">{e.dates[l]}</p>
            </div>
            <div class="etape__droite">
              <p class="etape__date etape__date--mobile" aria-hidden="true">
                {e.dates[l]}
              </p>
              <p class="etape__genre">{ui.parcours[e.genre][l]}</p>
              <h3 class="etape__titre">{e.titre[l]}</h3>
              <p class="etape__lieu">{e.lieu[l]}</p>
              {e.texte && <p class="etape__texte">{e.texte[l]}</p>}
              {e.projet && (
                <a class="lien etape__lien" href={lienRealisation(l, e.projet)}>
                  {ui.projets.fiche[l]} →
                </a>
              )}
            </div>
          </li>
        ))
      }
    </ol>
    <div class="frise__ligne" aria-hidden="true">
      <div class="frise__rayon" data-frise-rayon></div>
    </div>
  </div>
</section>

<script>
  // La ligne se remplit de 0 (haut de la frise à 10 % de l'écran) à 1 (bas de la frise à 50 %).
  const frise = document.querySelector<HTMLElement>('[data-frise]');
  const rayon = document.querySelector<HTMLElement>('[data-frise-rayon]');
  if (frise && rayon) {
    let attente = false;
    const maj = () => {
      attente = false;
      const r = frise.getBoundingClientRect();
      const h = innerHeight;
      const p = Math.min(1, Math.max(0, (0.1 * h - r.top) / (r.height - 0.4 * h)));
      rayon.style.setProperty('--avance', String(p));
    };
    const demander = () => {
      if (!attente) {
        attente = true;
        requestAnimationFrame(maj);
      }
    };
    addEventListener('scroll', demander, { passive: true });
    addEventListener('resize', demander);
    maj();
  }
</script>

<style>
  .frise {
    position: relative;
    inline-size: 100%;
    max-inline-size: min(80rem, 100% - 2 * var(--reserve-menu));
    margin: 0 auto;
    padding-block-end: 5rem;
  }
  @media (min-width: 48em) {
    .frise {
      padding-inline: 2.5rem;
    }
  }
  .frise__liste {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .etape {
    display: flex;
    justify-content: flex-start;
    padding-block-start: 2.5rem;
  }
  @media (min-width: 48em) {
    .etape {
      gap: 2.5rem;
      padding-block-start: 10rem;
    }
    .etape:first-child {
      padding-block-start: 2.5rem;
    }
  }

  /* À gauche : le point et la date, collés en haut de l'écran pendant la lecture */
  .etape__gauche {
    position: sticky;
    inset-block-start: 10rem;
    z-index: 4;
    display: flex;
    flex-direction: column;
    align-items: center;
    align-self: flex-start;
    max-inline-size: 20rem;
  }
  @media (min-width: 48em) {
    .etape__gauche {
      flex-direction: row;
      inline-size: 100%;
    }
  }
  @media (min-width: 64em) {
    .etape__gauche {
      max-inline-size: 24rem;
    }
  }
  .etape__point {
    position: absolute;
    inset-inline-start: 0.75rem;
    display: grid;
    place-items: center;
    inline-size: 2.5rem;
    block-size: 2.5rem;
    border-radius: 50%;
    background: color-mix(in oklch, var(--encre) 45%, var(--fond));
  }
  :global([data-theme='sombre']) .etape__point {
    background: #000;
  }
  .etape__point > span {
    inline-size: 1rem;
    block-size: 1rem;
    border-radius: 50%;
    background: var(--fond-2);
    border: 1px solid var(--trait-fort);
  }
  .etape--futur .etape__point > span {
    background: var(--accent);
  }
  .etape__date {
    display: none;
    margin: 0;
    font-family: var(--f-texte);
    font-size: 3rem;
    font-weight: 800;
    line-height: 1.05;
    color: var(--encre-2);
  }
  @media (min-width: 48em) {
    .etape__gauche .etape__date {
      display: block;
      padding-inline-start: 5rem;
    }
  }

  /* À droite : l'étape */
  .etape__droite {
    position: relative;
    inline-size: 100%;
    padding-inline: 5rem 1rem;
  }
  @media (min-width: 48em) {
    .etape__droite {
      padding-inline-start: 1rem;
    }
  }
  .etape__date--mobile {
    display: block;
    margin-block-end: 0.75rem;
    font-size: 1.5rem;
  }
  @media (min-width: 48em) {
    .etape__date--mobile {
      display: none;
    }
  }
  .etape__genre {
    margin: 0 0 0.5rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: var(--etiquette-interlettre);
    text-transform: uppercase;
    color: var(--accent-encre);
  }
  .etape__titre {
    margin-block-end: 0.75rem;
    font-family: var(--f-titre);
    font-size: clamp(1.75rem, 1.2rem + 2.2vw, 3rem);
    font-weight: var(--sous-titre-graisse);
    font-variation-settings: var(--titre-variation);
    line-height: 1.1;
  }
  .etape__lieu {
    margin: 0 0 1rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--encre-2);
  }
  .etape__texte {
    margin: 0 0 1.5rem;
    max-inline-size: 44rem;
    font-size: 0.875rem;
    line-height: 1.7;
  }

  /* La ligne et son rayon de couleur */
  .frise__ligne {
    position: absolute;
    inset-block: 0;
    inset-inline-start: 2rem;
    inline-size: 2px;
    overflow: hidden;
    background: linear-gradient(to bottom, transparent 0%, var(--trait-fort), transparent 99%);
    mask-image: linear-gradient(to bottom, transparent 0%, #000 10%, #000 90%, transparent 100%);
  }
  @media (min-width: 48em) {
    .frise__ligne {
      inset-inline-start: calc(2.5rem + 2rem);
    }
  }
  .frise__rayon {
    --avance: 0;
    position: absolute;
    inset-inline: 0;
    inset-block-start: 0;
    inline-size: 2px;
    block-size: calc(var(--avance) * 100%);
    border-radius: 999px;
    background: linear-gradient(to top, var(--accent) 0%, var(--accent-2) 10%, transparent);
    opacity: min(1, calc(var(--avance) * 10));
  }
  @media (prefers-reduced-motion: reduce) {
    .frise__rayon {
      --avance: 1 !important;
    }
  }
</style>
