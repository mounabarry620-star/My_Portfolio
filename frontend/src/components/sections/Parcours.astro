---
/**
 * Section 04 — Parcours, dessiné comme un plan de transport : deux lignes de couleur
 * (mécanique, puis informatique), une correspondance, des arrêts. Les étapes à venir
 * (stage, diplôme) sont en pointillés.
 */
import TitreSection from '../TitreSection.astro';
import Icone from '../Icone.astro';
import { ui } from '@/i18n/ui';
import type { Langue } from '@/i18n';
import { etapes, lignes } from '@/data/parcours';
import { lienRealisation } from '@/data/liens';

interface Props {
  langue: Langue;
}
const { langue: l } = Astro.props;
---

<section class="section section--bande" id="parcours" data-section="parcours" aria-labelledby="titre-parcours">
  <div class="conteneur parcours">
    <div class="parcours__tete">
      <TitreSection
        numero={4}
        id="parcours"
        etiquette={ui.parcours.etiquette[l]}
        titre={ui.parcours.titre[l]}
        intro={ui.parcours.intro[l]}
      />
      <ul class="legende" role="list" data-revele>
        {
          (['conakry', 'arles'] as const).map((id) => (
            <li class="legende__ligne" data-ligne={id}>
              <span class="legende__trait" aria-hidden="true" />
              <strong>{lignes[id].nom[l]}</strong>
              {lignes[id].note[l]}
            </li>
          ))
        }
      </ul>
    </div>

    <ol class="plan" role="list">
      {
        etapes.map((e) => (
          <li
            class:list={['arret', `arret--${e.genre}`, { 'arret--futur': e.futur }]}
            data-ligne={e.ligne}
            data-revele
          >
            <span class="arret__point" aria-hidden="true">
              {e.genre === 'correspondance' && <Icone nom="correspondance" taille={16} />}
            </span>
            <p class="arret__dates">{e.dates[l]}</p>
            <div class="arret__corps">
              <p class="etiquette arret__genre">{ui.parcours[e.genre][l]}</p>
              <h3 class="arret__titre">{e.titre[l]}</h3>
              <p class="arret__lieu">{e.lieu[l]}</p>
              {e.texte && <p class="arret__texte">{e.texte[l]}</p>}
              {e.projet && (
                <a class="lien" href={lienRealisation(l, e.projet)}>
                  {ui.commun.voirProjet[l]}
                  <Icone nom="fleche-droite" taille={16} />
                </a>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .parcours {
    display: grid;
    gap: 1rem clamp(2rem, 6vw, 6rem);
  }
  .parcours__tete :global(.section__tete) {
    margin-block-end: 1.5rem;
  }

  /* Couleur de chaque ligne */
  [data-ligne='conakry'] {
    --ligne: var(--accent-2);
  }
  [data-ligne='arles'] {
    --ligne: var(--accent-encre);
  }

  .legende {
    display: grid;
    gap: 0.5rem;
    margin: 0 0 2rem;
    font-size: var(--t-s);
    color: var(--encre-2);
  }
  .legende__ligne {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .legende__ligne strong {
    color: var(--encre);
    font-family: var(--f-etiquette);
  }
  .legende__trait {
    inline-size: 2.25rem;
    block-size: 0.375rem;
    border-radius: 999px;
    background: var(--ligne);
  }

  /* Le plan : un rail vertical, un arrêt par étape */
  .plan {
    --rail: 0.375rem;
    --point: 1.25rem;
    display: grid;
    margin: 0;
  }
  .arret {
    position: relative;
    display: grid;
    grid-template-columns: var(--point) 1fr;
    gap: 0.15rem 1.25rem;
    padding-block-end: clamp(1.75rem, 4vw, 2.75rem);
  }
  /* Tronçon de rail sous chaque arrêt */
  .arret::before {
    content: '';
    position: absolute;
    inset: calc(var(--point) / 2 + 0.2rem) auto 0 calc((var(--point) - var(--rail)) / 2);
    inline-size: var(--rail);
    background: var(--ligne);
    border-radius: 999px;
    transform-origin: 50% 0;
  }
  .arret:last-child::before {
    display: none;
  }
  .arret--futur::before,
  .arret:has(+ .arret--futur)::before {
    background: repeating-linear-gradient(to bottom, var(--ligne) 0 0.4rem, transparent 0.4rem 0.8rem);
    border-radius: 0;
  }
  /* Le rail se trace quand l'arrêt entre dans l'écran */
  :global(html.js) .arret[data-revele]::before {
    transform: scaleY(0);
    transition: transform 1.1s var(--sortie) 0.15s;
  }
  :global(html.js) .arret[data-revele].vu::before {
    transform: none;
  }

  .arret__point {
    grid-row: 1 / span 2;
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    inline-size: var(--point);
    block-size: var(--point);
    margin-block-start: 0.2rem;
    border-radius: 50%;
    background: var(--fond-2);
    border: 0.3rem solid var(--ligne);
    color: var(--sur-accent);
  }
  .arret--distinction .arret__point {
    background: var(--ligne);
    box-shadow: 0 0 0 0.3rem color-mix(in oklch, var(--ligne) 28%, transparent);
  }
  .arret--correspondance .arret__point {
    inline-size: 2rem;
    block-size: 2rem;
    margin-inline-start: -0.375rem;
    margin-block-start: -0.1rem;
    border: 0;
    background: var(--encre);
    color: var(--fond);
  }
  .arret--futur .arret__point {
    border-style: dotted;
    border-width: 0.25rem;
  }

  .arret__dates {
    grid-column: 2;
    font-family: var(--f-mono);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--encre-2);
    font-variant-numeric: tabular-nums;
  }
  .arret__corps {
    grid-column: 2;
    display: grid;
    gap: 0.3rem;
    justify-items: start;
  }
  .arret__genre {
    display: inline-block;
    padding: 0.22rem 0.55rem;
    border-radius: 999px;
    background: color-mix(in oklch, var(--ligne) 16%, transparent);
    font-size: 0.75rem;
  }
  .arret--objectif .arret__genre {
    background: var(--accent);
    color: var(--sur-accent);
  }
  .arret__titre {
    font-size: var(--t-xl);
    font-weight: var(--sous-titre-graisse);
    font-variation-settings: var(--titre-variation);
    letter-spacing: calc(var(--titre-interlettre) * 0.6);
    line-height: 1.14;
  }
  .arret__lieu {
    font-weight: 650;
  }
  .arret__texte {
    color: var(--encre-2);
    max-inline-size: 38rem;
  }
  .arret :global(.lien) {
    margin-block-start: 0.3rem;
  }

  @media (min-width: 62em) {
    .parcours {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.25fr);
      align-items: start;
    }
    /* Le titre reste visible pendant qu'on parcourt le plan */
    .parcours__tete {
      position: sticky;
      inset-block-start: calc(var(--entete-h) + 2.5rem);
    }
    .arret {
      grid-template-columns: 7.5rem var(--point) 1fr;
    }
    .arret::before {
      inset-inline-start: calc(7.5rem + 1.25rem + (var(--point) - var(--rail)) / 2);
    }
    .arret__dates {
      grid-column: 1;
      grid-row: 1;
      text-align: end;
      padding-block-start: 0.3rem;
    }
    .arret__point {
      grid-column: 2;
      grid-row: 1;
    }
    .arret__corps {
      grid-column: 3;
      grid-row: 1;
    }
  }
</style>
