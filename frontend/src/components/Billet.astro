---
/**
 * La fiche « Je recherche un stage » à côté de mon nom : ma photo, puis l'essentiel en clair
 * (poste, dates, rythme, lieu) et un QR code qui ouvre le CV.
 * Volontairement simple : une vraie photo, du texte lisible, aucun effet.
 */
import { Picture } from 'astro:assets';
import QRCode from 'qrcode';
import portrait from '@/assets/portrait.jpg';
import { ui } from '@/i18n/ui';
import { dateLongue, routes, type Langue } from '@/i18n';
import { stage } from '@/data/profil';

interface Props {
  langue: Langue;
}
const { langue: l } = Astro.props;
const b = ui.billet;

// QR code → dessin SVG (un petit carré par module sombre), fabriqué à la construction du site.
const qr = QRCode.create(new URL(routes.cv(l), Astro.site).href, { errorCorrectionLevel: 'M' });
const taille = qr.modules.size;
let trace = '';
for (let y = 0; y < taille; y++) for (let x = 0; x < taille; x++) if (qr.modules.get(y, x)) trace += `M${x} ${y}h1v1h-1z`;
---

<article class="billet" aria-labelledby="billet-titre">
  <div class="billet__photo">
    <Picture
      src={portrait}
      alt={ui.hero.portraitAlt[l]}
      formats={['avif']}
      fallbackFormat="webp"
      widths={[400, 600, 800, 1200]}
      sizes="(min-width: 30em) 24rem, calc(100vw - 2.5rem)"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      quality={74}
    />
  </div>

  <div class="billet__corps">
    <p class="etiquette billet__etiquette">{b.cherche[l]}</p>
    <h2 class="billet__titre" id="billet-titre">{b.stageDe[l]}</h2>

    <dl class="billet__infos">
      <div>
        <dt>{b.dates[l]}</dt>
        <dd>
          <time datetime={stage.debut}>{dateLongue(stage.debut, l)}</time>
          {l === 'fr' ? ' au ' : ' to '}
          <time datetime={stage.fin}>{dateLongue(stage.fin, l)}</time>
          <span class="billet__note">{b.semaines[l]} · {b.rythmeValeur[l].toLowerCase()}</span>
        </dd>
      </div>
      <div>
        <dt>{b.option[l]}</dt>
        <dd>{b.optionValeur[l]}</dd>
      </div>
      <div>
        <dt>{b.mobilite[l]}</dt>
        <dd>{b.mobiliteValeur[l]}</dd>
      </div>
    </dl>

    <a class="billet__cv" href={routes.cv(l)}>
      <svg class="billet__qr" viewBox={`-2 -2 ${taille + 4} ${taille + 4}`} shape-rendering="crispEdges" aria-hidden="true">
        <path d={trace}></path>
      </svg>
      <span>
        <strong>{b.voirCv[l]}</strong>
        <small>{b.qr[l]}</small>
      </span>
    </a>
  </div>
</article>

<style>
  .billet {
    inline-size: min(100%, 24rem);
    overflow: clip;
    border: 1px solid var(--trait);
    border-radius: var(--rayon);
    background: var(--surface);
    color: var(--encre);
    box-shadow: var(--ombre);
  }

  /* La photo telle qu'elle est, cadrée sur le visage */
  .billet__photo {
    aspect-ratio: 5 / 4;
    background: #8a8a8a;
  }
  .billet__photo :global(picture),
  .billet__photo :global(img) {
    display: block;
    inline-size: 100%;
    block-size: 100%;
  }
  .billet__photo :global(img) {
    object-fit: cover;
    object-position: 50% 18%;
  }

  .billet__corps {
    display: grid;
    gap: 0.9rem;
    padding: 1.1rem 1.2rem 1.2rem;
  }
  .billet__etiquette {
    color: var(--encre-2);
  }
  .billet__titre {
    margin-block-start: -0.55rem;
    font-family: var(--f-titre);
    font-size: 1.35rem;
    font-weight: var(--sous-titre-graisse);
    font-variation-settings: var(--titre-variation);
    letter-spacing: calc(var(--titre-interlettre) * 0.5);
    line-height: 1.15;
  }

  .billet__infos {
    display: grid;
    gap: 0.6rem;
    margin: 0;
    padding-block: 0.9rem;
    border-block: 1px dashed var(--trait-fort);
  }
  .billet__infos dt {
    font-size: 0.75rem;
    font-weight: 650;
    color: var(--encre-2);
  }
  .billet__infos dd {
    margin: 0;
    font-weight: 650;
    line-height: 1.35;
  }
  .billet__note {
    display: block;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--encre-2);
  }

  /* QR code + lien vers le CV : on peut scanner OU cliquer */
  .billet__cv {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.5rem;
    margin: -0.5rem;
    border-radius: var(--rayon-m);
    text-decoration: none;
  }
  .billet__cv:hover {
    background: var(--fond-2);
  }
  /* Le QR code reste noir sur blanc dans tous les thèmes : c'est ce que les téléphones lisent le mieux */
  .billet__qr {
    flex: none;
    inline-size: 4.25rem;
    block-size: 4.25rem;
    padding: 0.2rem;
    border-radius: var(--rayon-s);
    background: #fff;
    fill: #14110f;
  }
  .billet__cv span {
    display: grid;
    gap: 0.1rem;
  }
  .billet__cv strong {
    color: var(--accent-encre);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .billet__cv small {
    font-size: 0.8125rem;
    color: var(--encre-2);
  }
</style>
