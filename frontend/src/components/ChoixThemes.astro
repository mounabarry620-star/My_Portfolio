---
/**
 * Les quatre thèmes. Chacun correspond à un lieu du parcours et possède
 * ses couleurs ET sa typographie : l'aperçu « Aa » est écrit dans la police du thème.
 * Sur téléphone, l'aperçu « Aa » est masqué pour ne pas télécharger quatre polices
 * à l'ouverture du menu : elles ne sont chargées qu'au moment du choix.
 */
import { ui } from '@/i18n/ui';
import type { Langue } from '@/i18n';

interface Props {
  langue: Langue;
}
const { langue: l } = Astro.props;
const themes = ['arles', 'marseille', 'conakry', 'machine'] as const;
---

<div class="themes" role="group" aria-label={ui.reglages.choisirTheme[l]}>
  {
    themes.map((t) => (
      <button type="button" class="theme" data-choix-theme={t} aria-pressed="false">
        <span class="theme__apercu" data-theme={t} aria-hidden="true">
          <span class="theme__aa">Aa</span>
        </span>
        <span class="theme__textes">
          <span class="theme__nom">{ui.themes[t].nom[l]}</span>
          <span class="theme__note">{ui.themes[t].note[l]}</span>
        </span>
        <span class="theme__points" data-theme={t} aria-hidden="true">
          <i />
          <i />
          <i />
        </span>
      </button>
    ))
  }
</div>

<style>
  .themes {
    display: grid;
    gap: 0.5rem;
  }
  .theme {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.85rem;
    inline-size: 100%;
    padding: 0.55rem 0.9rem 0.55rem 0.55rem;
    border-radius: var(--rayon-m);
    text-align: start;
    box-shadow: inset 0 0 0 1px var(--trait);
    transition:
      transform 0.3s var(--sortie),
      box-shadow 0.3s,
      background-color 0.3s;
  }
  @media (hover: hover) {
    .theme:hover {
      background: color-mix(in oklch, var(--encre) 6%, transparent);
    }
    .theme:hover .theme__apercu {
      transform: rotate(-6deg) scale(1.05);
    }
  }
  .theme[aria-pressed='true'] {
    box-shadow: inset 0 0 0 2px var(--accent-encre);
  }
  /* L'aperçu porte data-theme : il s'affiche avec les couleurs et la police de SON thème. */
  .theme__apercu {
    display: grid;
    place-items: center;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    border-radius: calc(var(--rayon-m) - 0.2rem);
    background: var(--fond);
    color: var(--encre);
    box-shadow: inset 0 0 0 1px var(--trait-fort);
    font-family: var(--f-titre);
    font-size: 1.25rem;
    font-weight: var(--titre-graisse);
    font-variation-settings: var(--titre-variation);
    letter-spacing: -0.04em;
    line-height: 1;
    transition: transform 0.5s var(--ressort);
  }
  .theme__textes {
    display: grid;
    line-height: 1.25;
  }
  .theme__nom {
    font-family: var(--f-etiquette);
    font-weight: 700;
    font-size: 0.9375rem;
  }
  .theme__note {
    font-family: var(--f-etiquette);
    font-size: 0.78rem;
    color: var(--encre-2);
  }
  .theme__points {
    display: flex;
    gap: 0.2rem;
  }
  .theme__points i {
    inline-size: 0.7rem;
    block-size: 0.7rem;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 1px var(--trait);
  }
  .theme__points i:nth-child(2) {
    background: var(--accent-2);
  }
  .theme__points i:nth-child(3) {
    background: var(--fond);
  }
  @media (hover: none) and (pointer: coarse) {
    .theme__aa {
      display: none;
    }
    .theme__apercu {
      background: linear-gradient(135deg, var(--fond) 0 50%, var(--accent) 50% 100%);
    }
  }
</style>
