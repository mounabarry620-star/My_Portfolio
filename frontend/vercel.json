{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/cv/fr",
      "destination": "https://portfolio-mamadou-bailo-barry.mounabarry620.workers.dev/cv/",
      "permanent": true
    },
    {
      "source": "/cv/en",
      "destination": "https://portfolio-mamadou-bailo-barry.mounabarry620.workers.dev/en/cv/",
      "permanent": true
    },
    {
      "source": "/personal",
      "destination": "https://portfolio-mamadou-bailo-barry.mounabarry620.workers.dev/",
      "permanent": true
    },
    {
      "source": "/:chemin*",
      "destination": "https://portfolio-mamadou-bailo-barry.mounabarry620.workers.dev/:chemin*",
      "permanent": true
    }
  ]
}
